,\"fr\":\"École de la fonction publique du Canada\"},\"60\":{\"en\":\"Canada Water Agency\",\"fr\":\"Agence de l'eau du Canada\"},\"86\":{\"en\":\"Canadian Food Inspection Agency\",\"fr\":\"Agence canadienne d'inspection des aliments\"},\"25\":{\"en\":\"Canadian Grain Commission\",\"fr\":\"Commission canadienne des grains\"},\"20\":{\"en\":\"Canadian Heritage\",\"fr\":\"Patrimoine canadien\"},\"35\":{\"en\":\"Canadian Institutes of Health Research\",\"fr\":\"Instituts de recherche en santé du Canada\"},\"69\":{\"en\":\"Canadian Nuclear Safety Commission\",\"fr\":\"Commission canadienne de sûreté nucléaire\"},\"31\":{\"en\":\"Canadian Radio-television and Telecommunications Commission\",\"fr\":\"Conseil de la radiodiffusion et des télécommunications canadiennes\"},\"33\":{\"en\":\"Canadian Space Agency\",\"fr\":\"Agence spatiale canadienne\"},\"54\":{\"en\":\"Canadian Transportation Agency\",\"fr\":\"Office des transports du Canada\"},\"89\":{\"en\":\"Communications Security Establishment Canada\",\"fr\":\"Centre de la sécurité des télécommunications Canada\"},\"4\":{\"en\":\"Correctional Service Canada\",\"fr\":\"Service correctionnel Canada\"},\"30\":{\"en\":\"Courts Administration Service\",\"fr\":\"Service administratif des tribunaux judiciaires\"},\"22\":{\"en\":\"Crown-Indigenous Relations and Northern Affairs Canada\",\"fr\":\"Relations Couronne-Autochtones et Affaires du Nord Canada\"},\"24\":{\"en\":\"Department of Finance Canada\",\"fr\":\"Ministère des Finances Canada\"},\"19\":{\"en\":\"Department of Justice Canada\",\"fr\":\"Ministère de la Justice Canada\"},\"2\":{\"en\":\"Employment and Social Development Canada\",\"fr\":\"Emploi et Développement social Canada\"},\"11\":{\"en\":\"Environment and Climate Change Canada\",\"fr\":\"Environnement et Changement climatique Canada\"},\"93\":{\"en\":\"Federal Economic Development Agency for Southern Ontario\",\"fr\":\"Agence fédérale de développement économique pour le Sud de l'Ontario\"},\"57\":{\"en\":\"Financial Consumer Agency of Canada\",\"fr\":\"Agence de la consommation en matière financière du Canada\"},\"87\":{\"en\":\"Financial Transactions and Reports Analysis Centre of Canada\",\"fr\":\"Centre d'analyse des opérations et déclarations financières du Canada\"},\"5\":{\"en\":\"Fisheries and Oceans Canada\",\"fr\":\"Pêches et Océans Canada\"},\"14\":{\"en\":\"Global Affairs Canada\",\"fr\":\"Affaires mondiales Canada\"},\"6\":{\"en\":\"Health Canada\",\"fr\":\"Santé Canada\"},\"82\":{\"en\":\"Housing, Infrastructure and Communities Canada\",\"fr\":\"Logement, Infrastructures et Collectivités Canada\"},\"23\":{\"en\":\"Immigration and Refugee Board of Canada\",\"fr\":\"Commission de l'immigration et du statut de réfugié du Canada\"},\"13\":{\"en\":\"Immigration, Refugees and Citizenship Canada\",\"fr\":\"Immigration, Réfugiés et Citoyenneté Canada\"},\"47\":{\"en\":\"Impact Assessment Agency of Canada\",\"fr\":\"Agence d'évaluation d'impact du Canada\"},\"17\":{\"en\":\"Indigenous Services Canada\",\"fr\":\"Services aux Autochtones Canada\"},\"10\":{\"en\":\"Innovation, Science and Economic Development Canada\",\"fr\":\"Innovation, Sciences et Développement économique Canada\"},\"74\":{\"en\":\"Library and Archives Canada\",\"fr\":\"Bibliothèque et Archives Canada\"},\"95\":{\"en\":\"Micro-organizations combined\",\"fr\":\"Micro-organisations combinées\"},\"3\":{\"en\":\"National Defence\",\"fr\":\"Défense nationale\"},\"92\":{\"en\":\"National Film Board of Canada\",\"fr\":\"Office national du film du Canada\"},\"50\":{\"en\":\"National Research Council Canada\",\"fr\":\"Conseil national de recherches Canada\"},\"15\":{\"en\":\"Natural Resources Canada\",\"fr\":\"Ressources naturelles Canada\"},\"81\":{\"en\":\"Natural Sciences and Engineering Research Council of Canada\",\"fr\":\"Conseil de recherches en sciences naturelles et en génie du Canada\"},\"52\":{\"en\":\"Office of the Auditor General of Canada\",\"fr\":\"Bureau du vérificateur général du Canada\"},\"40\":{\"en\":\"Office of the Chief Electoral Officer\",\"fr\":\"Bureau du directeur général des élections\"},\"42\":{\"en\":\"Office of the Commissioner of Official Languages\",\"fr\":\"Commissariat aux langues officielles\"},\"80\":{\"en\":\"Office of the Privacy Commissioner of Canada\",\"fr\":\"Commissariat à la protection de la vie privée du Canada\"},\"88\":{\"en\":\"Parks Canada\",\"fr\":\"Parcs Canada\"},\"36\":{\"en\":\"Parole Board of Canada\",\"fr\":\"Commission des libérations conditionnelles du Canada\"},\"76\":{\"en\":\"Prairies Economic Development Canada\",\"fr\":\"Développement économique Canada pour les Prairies\"},\"28\":{\"en\":\"Privy Council Office\",\"fr\":\"Bureau du Conseil privé\"},\"70\":{\"en\":\"Public Health Agency of Canada\",\"fr\":\"Agence de la santé publique du Canada\"},\"46\":{\"en\":\"Public Prosecution Service of Canada\",\"fr\":\"Service des poursuites pénales du Canada\"},\"53\":{\"en\":\"Public Safety Canada\",\"fr\":\"Sécurité publique Canada\"},\"21\":{\"en\":\"Public Service Commission of Canada\",\"fr\":\"Commission de la fonction publique du Canada\"},\"7\":{\"en\":\"Public Services and Procurement Canada\",\"fr\":\"Services publics et Approvisionnement Canada\"},\"16\":{\"en\":\"Royal Canadian Mounted Police\",\"fr\":\"Gendarmerie royale du Canada\"},\"37\":{\"en\":\"Shared Services Canada\",\"fr\":\"Services partagés Canada\"},\"56\":{\"en\":\"Social Sciences and Humanities Research Council of Canada\",\"fr\":\"Conseil de recherches en sciences humaines du Canada\"},\"8\":{\"en\":\"Statistics Canada\",\"fr\":\"Statistique Canada\"},\"12\":{\"en\":\"Transport Canada\",\"fr\":\"Transports Canada\"},\"39\":{\"en\":\"Transportation Safety Board of Canada\",\"fr\":\"Bureau de la sécurité des transports du Canada\"},\"26\":{\"en\":\"Treasury Board of Canada Secretariat\",\"fr\":\"Secrétariat du Conseil du Trésor du Canada\"},\"18\":{\"en\":\"Veterans Affairs Canada\",\"fr\":\"Anciens Combattants Canada\"},\"61\":{\"en\":\"Veterans Review and Appeal Board\",\"fr\":\"Tribunal des anciens combattants (révision et appel)\"},\"90\":{\"en\":\"Women and Gender Equality Canada\",\"fr\":\"Femmes et Égalité des genres Canada\"},\"0\":{\"en\":\"Public Service\",\"fr\":\"Fonction publique\"},\"41\":{\"en\":\"Canadian Human Rights Commission\",\"fr\":\"Commission canadienne des droits de la personne\"},\"44\":{\"en\":\"Supreme Court of Canada\",\"fr\":\"Cour suprême du Canada\"},\"73\":{\"en\":\"Office of the Secretary to the Governor General\",\"fr\":\"Bureau du secrétaire du gouverneur général\"}},\"questions\":[{\"id\":\"Q01\",\"year\":\"2024\",\"en\":\"Question 1. I have the tools, technology and equipment I need to do my job.\",\"fr\":\"Question 1. Je dispose des outils, de la technologie et de l'équipement dont j'ai besoin pour effectuer mon travail.\",\"labelled\":true},{\"id\":\"Q02\",\"year\":\"2024\",\"en\":\"Question 2. During meetings in my work unit, I feel free to use the official language of my choice.\",\"fr\":\"Question 2. Durant les réunions de mon unité de travail, je me sens libre d’utiliser la langue officielle de mon choix.\",\"labelled\":true},{\"id\":\"Q03\",\"year\":\"2024\",\"en\":\"Question 3. When I prepare written materials, including emails, I feel free to use the official language of my choice.\",\"fr\":\"Question 3. Lorsque je rédige des documents, y compris des courriels, je me sens libre de le faire dans la langue officielle de mon choix.\",\"labelled\":true},{\"id\":\"Q04\",\"year\":\"2024\",\"en\":\"Question 4. My physical environment (e.g., office, workspace) is suitable for my job requirements.\",\"fr\":\"Question 4. Mon environnement physique (p. ex. bureau, espace de travail) est adapté aux exigences de mon travail.\",\"labelled\":true},{\"id\":\"Q05\",\"year\":\"2024\",\"en\":\"Question 5. I get the training I need to do my job.\",\"fr\":\"Question 5. Je reçois la formation dont j'ai besoin pour faire mon travail.\",\"labelled\":true},{\"id\":\"Q06\",\"year\":\"2024\",\"en\":\"Question 6. I have the information, training and equipment I need to ensure my health and safety at work.\",\"fr\":\"Question 6. J'ai l'information, la formation et l'équipement dont j'ai besoin pour assurer ma santé et ma sécurité au travail.\",\"labelled\":true},{\"id\":\"Q07\",\"year\":\"2024\",\"en\":\"Question 7. I have support at work to balance my work and personal life.\",\"fr\":\"Question 7. Je reçois du soutien au travail pour concilier mon travail et ma vie personnelle.\",\"labelled\":true},{\"id\":\"Q08\",\"year\":\"2024\",\"en\":\"Question 8. I get a sense of satisfaction from my work.\",\"fr\":\"Question 8. Je tire de la satisfaction de mon travail.\",\"labelled\":true},{\"id\":\"Q09\",\"year\":\"2024\",\"en\":\"Question 9. I receive meaningful recognition for work well done.\",\"fr\":\"Question 9. Je reçois une reconnaissance significative lorsque je fais un bon travail.\",\"labelled\":true},{\"id\":\"Q10\",\"year\":\"2024\",\"en\":\"Question 10. I have clear work objectives.\",\"fr\":\"Question 10. J'ai des objectifs de travail clairs.\",\"labelled\":true},{\"id\":\"Q11\",\"year\":\"2024\",\"en\":\"Question 11. I know how my work contributes to the achievement of my department's or agency's goals.\",\"fr\":\"Question 11. Je sais de quelle façon mon travail contribue à l'atteinte des objectifs de mon ministère ou organisme.\",\"labelled\":true},{\"id\":\"Q12\",\"year\":\"2024\",\"en\":\"Question 12. Overall, I feel valued at work.\",\"fr\":\"Question 12. Dans l'ensemble, je me sens valorisé(e) au travail.\",\"labelled\":true},{\"id\":\"Q13\",\"year\":\"2024\",\"en\":\"Question 13. I am proud of the work that I do.\",\"fr\":\"Question 13. Je suis fier (fière) du travail que je fais.\",\"labelled\":true},{\"id\":\"Q14\",\"year\":\"2024\",\"en\":\"Question 14. I have opportunities to provide input into decisions that affect my work.\",\"fr\":\"Question 14. J'ai l'occasion de contribuer aux décisions qui touchent mon travail.\",\"labelled\":true},{\"id\":\"Q15\",\"year\":\"2024\",\"en\":\"Question 15. I am encouraged to be innovative or to take initiative in my work.\",\"fr\":\"Question 15. On m'encourage à innover ou à prendre des initiatives dans mon travail.\",\"labelled\":true},{\"id\":\"Q16\",\"year\":\"2024\",\"en\":\"Question 16. I have support at work to provide a high level of service.\",\"fr\":\"Question 16. Au travail, j'obtiens du soutien pour fournir un service de haute qualité.\",\"labelled\":true},{\"id\":\"Q17\",\"year\":\"2024\",\"en\":\"Question 17. Overall, I like my job.\",\"fr\":\"Question 17. Dans l'ensemble, j'aime mon emploi.\",\"labelled\":true},{\"id\":\"Q18\",\"year\":\"2024\",\"en\":\"Question 18. I can complete my assigned workload during my regular working hours.\",\"fr\":\"Question 18. J'arrive à accomplir les tâches qui me sont assignées pendant mes heures normales de travail.\",\"labelled\":true},{\"id\":\"Q19a\",\"year\":\"2024\",\"en\":\"Question 19a. I feel that the quality of my work suffers because of... constantly changing priorities.\",\"fr\":\"Question 19a. J'estime que la qualité de mon travail est minée parce que... les priorités changent constamment.\",\"labelled\":true},{\"id\":\"Q19b\",\"year\":\"2024\",\"en\":\"Question 19b. I feel that the quality of my work suffers because of... too many approval stages.\",\"fr\":\"Question 19b. J'estime que la qualité de mon travail est minée parce que... il y a un trop grand nombre d'étapes d'approbation.\",\"labelled\":true},{\"id\":\"Q19c\",\"year\":\"2024\",\"en\":\"Question 19c. I feel that the quality of my work suffers because of... unreasonable deadlines.\",\"fr\":\"Question 19c. J'estime que la qualité de mon travail est minée parce que... les échéanciers sont déraisonnables.\",\"labelled\":true},{\"id\":\"Q19d\",\"year\":\"2024\",\"en\":\"Question 19d. I feel that the quality of my work suffers because of... having to do the same or more work, but with fewer resources.\",\"fr\":\"Question 19d. J'estime que la qualité de mon travail est minée parce que... je dois faire le même travail, ou en faire plus, avec moins de ressources.\",\"labelled\":true},{\"id\":\"Q19e\",\"year\":\"2024\",\"en\":\"Question 19e. I feel that the quality of my work suffers because of... high staff turnover.\",\"fr\":\"Question 19e. J'estime que la qualité de mon travail est minée parce que... le taux de roulement du personnel est élevé.\",\"labelled\":true},{\"id\":\"Q19f\",\"year\":\"2024\",\"en\":\"Question 19f. I feel that the quality of my work suffers because of... overly complicated or unnecessary business processes.\",\"fr\":\"Question 19f. J'estime que la qualité de mon travail est minée parce que... les processus opérationnels sont trop compliqués ou inutiles.\",\"labelled\":true},{\"id\":\"Q19g\",\"year\":\"2024\",\"en\":\"Question 19g. I feel that the quality of my work suffers because of... unreliable technology.\",\"fr\":\"Question 19g. J'estime que la qualité de mon travail est minée parce que... les technologies sont peu fiables.\",\"labelled\":true},{\"id\":\"Q20\",\"year\":\"2024\",\"en\":\"Question 20. I am satisfied with how interpersonal issues are resolved in my work unit.\",\"fr\":\"Question 20. Je suis satisfait(e) de la manière dont les problèmes interpersonnels sont réglés dans mon unité de travail.\",\"labelled\":true},{\"id\":\"Q21\",\"year\":\"2024\",\"en\":\"Question 21. In my work unit, every individual is accepted as an equal member of the team.\",\"fr\":\"Question 21. Dans mon unité de travail, chaque personne est acceptée comme membre à part entière de l'équipe.\",\"labelled\":true},{\"id\":\"Q22\",\"year\":\"2024\",\"en\":\"Question 22. In my work unit, individuals behave in a respectful manner.\",\"fr\":\"Question 22. Dans mon unité de travail, les gens se comportent de manière respectueuse.\",\"labelled\":true},{\"id\":\"Q23\",\"year\":\"2024\",\"en\":\"Question 23. The people I work with value my ideas and opinions.\",\"fr\":\"Question 23. Les personnes avec lesquelles je travaille valorisent mes idées et mes opinions.\",\"labelled\":true},{\"id\":\"Q24\",\"year\":\"2024\",\"en\":\"Question 24. In my work unit, I would feel safe to speak about racism in the workplace without fear of reprisal or negative impact on my career.\",\"fr\":\"Question 24. Dans mon unité de travail, je me sentirais à l’aise de parler de racisme en milieu de travail sans crainte de représailles ou d’impact négatif sur ma carrière.\",\"labelled\":true},{\"id\":\"Q25\",\"year\":\"2024\",\"en\":\"Question 25. In my work unit, I would feel safe to speak about racism in the workplace without negative impact on my mental health.\",\"fr\":\"Question 25. Dans mon unité de travail, je me sentirais à l’aise de parler de racisme en milieu de travail sans impact négatif sur ma santé mentale.\",\"labelled\":true},{\"id\":\"Q26\",\"year\":\"2024\",\"en\":\"Question 26. My immediate supervisor encourages me to work collaboratively with others outside of my work unit.\",\"fr\":\"Question 26. Mon (ma) superviseur(e) immédiat(e) m'encourage à travailler en collaboration avec d'autres personnes à l'extérieur de mon unité de travail.\",\"labelled\":true},{\"id\":\"Q27\",\"year\":\"2024\",\"en\":\"Question 27. I receive useful feedback from my immediate supervisor on my job performance.\",\"fr\":\"Question 27. Je reçois de la rétroaction utile de mon (ma) superviseur(e) immédiat(e) sur mon rendement au travail.\",\"labelled\":true},{\"id\":\"Q28\",\"year\":\"2024\",\"en\":\"Question 28. I feel that my immediate supervisor supports my career goals.\",\"fr\":\"Question 28. J'estime que mon (ma) superviseur(e) immédiat(e) soutient mes aspirations professionnelles.\",\"labelled\":true},{\"id\":\"Q29\",\"year\":\"2024\",\"en\":\"Question 29. My immediate supervisor keeps me informed about the issues affecting my work.\",\"fr\":\"Question 29. Mon (ma) superviseur(e) immédiat(e) me tient au courant des questions touchant mon travail.\",\"labelled\":true},{\"id\":\"Q30\",\"year\":\"2024\",\"en\":\"Question 30. My immediate supervisor supports the use of flexible work hours (e.g., varying the start and end times of the workday).\",\"fr\":\"Question 30. Mon (ma) superviseur(e) immédiat(e) est en faveur d’un horaire flexible (p. ex. varier les heures de début et de fin de la journée de travail).\",\"labelled\":true},{\"id\":\"Q31\",\"year\":\"2024\",\"en\":\"Question 31. I am satisfied with the quality of supervision I receive.\",\"fr\":\"Question 31. Je suis satisfait(e) de la qualité de la supervision qui est exercée à mon égard.\",\"labelled\":true},{\"id\":\"Q32\",\"year\":\"2024\",\"en\":\"Question 32. When I communicate with my immediate supervisor, I feel free to use the official language of my choice.\",\"fr\":\"Question 32. Lorsque je communique avec mon (ma) superviseur(e) immédiat(e), je me sens libre de le faire dans la langue officielle de mon choix.\",\"labelled\":true},{\"id\":\"Q33\",\"year\":\"2024\",\"en\":\"Question 33. Senior managers in my department or agency lead by example in ethical behaviour.\",\"fr\":\"Question 33. Les cadres supérieurs de mon ministère ou organisme montrent l'exemple par leur comportement éthique.\",\"labelled\":true},{\"id\":\"Q34\",\"year\":\"2024\",\"en\":\"Question 34. I have confidence in the senior management of my department or agency.\",\"fr\":\"Question 34. J'ai confiance en la haute direction de mon ministère ou organisme.\",\"labelled\":true},{\"id\":\"Q35\",\"year\":\"2024\",\"en\":\"Question 35. Senior management in my department or agency makes effective and timely decisions.\",\"fr\":\"Question 35. La haute direction de mon ministère ou organisme prend des décisions efficaces et opportunes.\",\"labelled\":true},{\"id\":\"Q36\",\"year\":\"2024\",\"en\":\"Question 36. Essential information flows effectively from senior management to staff.\",\"fr\":\"Question 36. La haute direction communique efficacement les renseignements essentiels au personnel.\",\"labelled\":true},{\"id\":\"Q37\",\"year\":\"2024\",\"en\":\"Question 37. Senior managers in my department or agency use both official languages in their interactions with employees.\",\"fr\":\"Question 37. Les cadres supérieur(e)s de mon ministère ou organisme utilisent les deux langues officielles dans leurs interactions avec les employé(e)s.\",\"labelled\":true},{\"id\":\"Q38\",\"year\":\"2024\",\"en\":\"Question 38. My department or agency does a good job of communicating its vision, mission and goals.\",\"fr\":\"Question 38. Mon ministère ou organisme communique efficacement sa vision, sa mission et ses objectifs.\",\"labelled\":true},{\"id\":\"Q39\",\"year\":\"2024\",\"en\":\"Question 39. I feel that change is managed well in my department or agency.\",\"fr\":\"Question 39. J'estime que le changement est bien géré au sein de mon ministère ou organisme.\",\"labelled\":true},{\"id\":\"Q40\",\"year\":\"2024\",\"en\":\"Question 40. If I am faced with an ethical dilemma or a conflict between values in the workplace, I know where I can go for help in resolving the situation.\",\"fr\":\"Question 40. Si j'étais confronté(e) à un dilemme éthique ou à un conflit entre les valeurs du milieu de travail, je saurais où aller pour obtenir de l'aide afin de régler le problème.\",\"labelled\":true},{\"id\":\"Q41\",\"year\":\"2024\",\"en\":\"Question 41. My department or agency does a good job of promoting values and ethics in the workplace.\",\"fr\":\"Question 41. Mon ministère ou organisme fait un bon travail de promotion des valeurs et de l'éthique dans le milieu de travail.\",\"labelled\":true},{\"id\":\"Q42\",\"year\":\"2024\",\"en\":\"Question 42. I feel I can initiate a formal recourse process (e.g., grievance, complaint, appeal) without fear of reprisal.\",\"fr\":\"Question 42. J'estime pouvoir amorcer un processus de recours officiel (p. ex. grief, plainte, droit d'appel) sans crainte de représailles.\",\"labelled\":true},{\"id\":\"Q43\",\"year\":\"2024\",\"en\":\"Question 43. My department or agency does a good job of supporting employee career development.\",\"fr\":\"Question 43. Mon ministère ou organisme met tout en œuvre pour appuyer ses employé(e)s dans leur perfectionnement professionnel.\",\"labelled\":true},{\"id\":\"Q44a\",\"year\":\"2024\",\"en\":\"Question 44a. To what extent have the following adversely affected your career progress in the federal public service over the last 12 months? Conflict between my work obligations and my family or personal obligations\",\"fr\":\"Question 44a. Dans quelle mesure estimez-vous que les éléments suivants ont nui à la progression de votre carrière au sein de la fonction publique fédérale au cours des 12 derniers mois? Conflit entre mes obligations professionnelles et mes obligations familiales ou personnelles\",\"labelled\":true},{\"id\":\"Q44b\",\"year\":\"2024\",\"en\":\"Question 44b. To what extent have the following adversely affected your career progress in the federal public service over the last 12 months? Lack of access to language training in my second official language\",\"fr\":\"Question 44b. Dans quelle mesure estimez-vous que les éléments suivants ont nui à la progression de votre carrière au sein de la fonction publique fédérale au cours des 12 derniers mois? Manque d'accès à de la formation linguistique dans ma seconde langue officielle\",\"labelled\":true},{\"id\":\"Q44c\",\"year\":\"2024\",\"en\":\"Question 44c. To what extent have the following adversely affected your career progress in the federal public service over the last 12 months? Discrimination\",\"fr\":\"Question 44c. Dans quelle mesure estimez-vous que les éléments suivants ont nui à la progression de votre carrière au sein de la fonction publique fédérale au cours des 12 derniers mois? Discrimination\",\"labelled\":true},{\"id\":\"Q44d\",\"year\":\"2024\",\"en\":\"Question 44d. To what extent have the following adversely affected your career progress in the federal public service over the last 12 months? Accessibility issues\",\"fr\":\"Question 44d. Dans quelle mesure estimez-vous que les éléments suivants ont nui à la progression de votre carrière au sein de la fonction publique fédérale au cours des 12 derniers mois? Problèmes d'accessibilité\",\"labelled\":true},{\"id\":\"Q44e\",\"year\":\"2024\",\"en\":\"Question 44e. To what extent have the following adversely affected your career progress in the federal public service over the last 12 months? Accommodation issues\",\"fr\":\"Question 44e. Dans quelle mesure estimez-vous que les éléments suivants ont nui à la progression de votre carrière au sein de la fonction publique fédérale au cours des 12 derniers mois? Problèmes d'adaptation\",\"labelled\":true},{\"id\":\"Q45\",\"year\":\"2024\",\"en\":\"Question 45. I believe I have opportunities for promotion within my department or agency, given my education, skills and experience.\",\"fr\":\"Question 45. J'estime avoir des possibilités d'obtenir une promotion au sein de mon ministère ou organisme, compte tenu de ma scolarité, de mes compétences et de mon expérience.\",\"labelled\":true},{\"id\":\"Q46\",\"year\":\"2024\",\"en\":\"Question 46. I feel I would be supported by my department or agency if I proposed a new idea.\",\"fr\":\"Question 46. J'estime que j'obtiendrais du soutien de mon ministère ou organisme si je proposais une nouvelle idée.\",\"labelled\":true},{\"id\":\"Q47\",\"year\":\"2024\",\"en\":\"Question 47. I think that my department or agency respects individual differences (e.g., culture, work styles, ideas, abilities).\",\"fr\":\"Question 47. Je crois que mon ministère ou organisme respecte les différences individuelles (p. ex. la culture, les méthodes de travail, les idées, les habiletés).\",\"labelled\":true},{\"id\":\"Q48\",\"year\":\"2024\",\"en\":\"Question 48. My department or agency implements activities and practices that support a diverse workforce.\",\"fr\":\"Question 48. Mon ministère ou organisme met en place des activités et des pratiques qui favorisent une main d’œuvre diversifiée.\",\"labelled\":true},{\"id\":\"Q49\",\"year\":\"2024\",\"en\":\"Question 49. My department or agency implements initiatives that promote anti-racism in the workplace.\",\"fr\":\"Question 49. Mon ministère ou organisme met en œuvre des initiatives qui favorisent la lutte contre le racisme dans le milieu de travail.\",\"labelled\":true},{\"id\":\"Q50\",\"year\":\"2024\",\"en\":\"Question 50. I would feel comfortable sharing concerns about racism in the workplace with a person of authority (e.g., immediate supervisor, senior manager, ombudsperson, human resources advisor).\",\"fr\":\"Question 50. Je me sentirais à l’aise de faire part à une personne en situation d’autorité de mes préoccupations concernant des problèmes liés au racisme en milieu de travail (p. ex. superviseur(e) immédiat(e), cadre supérieur(e), ombudsman, conseiller(ère) en ressources humaines).\",\"labelled\":true},{\"id\":\"Q51\",\"year\":\"2024\",\"en\":\"Question 51. I feel that racism in my department or agency has had an adverse or negative impact on my mental health.\",\"fr\":\"Question 51. J’estime que le racisme dans mon ministère ou organisme a eu une incidence négative sur ma santé mentale.\",\"labelled\":true},{\"id\":\"Q52\",\"year\":\"2024\",\"en\":\"Question 52. I feel that the Call to Action on Anti-Racism, Equity and Inclusion has had a positive impact in my department or agency, since it launched in January 2021.\",\"fr\":\"Question 52. J’estime que l’Appel à l’action en faveur de la lutte contre le racisme, de l’équité et de l’inclusion a eu un impact positif au sein de mon ministère ou organisme depuis son lancement, en janvier 2021.\",\"labelled\":true},{\"id\":\"Q53\",\"year\":\"2024\",\"en\":\"Question 53. Overall, my department or agency treats me with respect.\",\"fr\":\"Question 53. Dans l'ensemble, mon ministère ou organisme me traite avec respect.\",\"labelled\":true},{\"id\":\"Q54\",\"year\":\"2024\",\"en\":\"Question 54. I would recommend my department or agency as a great place to work.\",\"fr\":\"Question 54. Je recommanderais mon ministère ou organisme comme un excellent milieu de travail.\",\"labelled\":true},{\"id\":\"Q55\",\"year\":\"2024\",\"en\":\"Question 55. I am satisfied with my department or agency.\",\"fr\":\"Question 55. Je suis satisfait(e) de mon ministère ou organisme.\",\"labelled\":true},{\"id\":\"Q56\",\"year\":\"2024\",\"en\":\"Question 56. I would prefer to remain with my department or agency, even if a comparable job was available elsewhere in the federal public service.\",\"fr\":\"Question 56. Je préférerais continuer à travailler au sein de mon ministère ou organisme même si un poste comparable était disponible ailleurs dans la fonction publique fédérale.\",\"labelled\":true},{\"id\":\"D57_1\",\"year\":\"2024\",\"en\":\"Question 57_1. Do you intend to leave your current position in the next two years?\",\"fr\":\"Question 57_1. Avez-vous l'intention de quitter votre poste actuel au cours des deux prochaines années?\",\"labelled\":true},{\"id\":\"D57_2\",\"year\":\"2024\",\"en\":\"Question 57_2. Please indicate your reason for leaving.\",\"fr\":\"Question 57_2. Veuillez indiquer la raison de votre départ.\",\"labelled\":true},{\"id\":\"Q58\",\"year\":\"2024\",\"en\":\"Question 58. Having carefully read the definition of harassment above, have you been the victim of harassment on the job in the past 12 months?\",\"fr\":\"Question 58. Après avoir lu attentivement la définition du harcèlement ci-dessus, au cours des 12 derniers mois, avez-vous été victime de harcèlement au travail?\",\"labelled\":true},{\"id\":\"Q59a\",\"year\":\"2024\",\"en\":\"Question 59a. From whom did you experience harassment on the job? Co-workers\",\"fr\":\"Question 59a. De la part de qui avez-vous été victime de harcèlement au travail? Collègues\",\"labelled\":true},{\"id\":\"Q59b\",\"year\":\"2024\",\"en\":\"Question 59b. From whom did you experience harassment on the job? Individuals with authority over me\",\"fr\":\"Question 59b. De la part de qui avez-vous été victime de harcèlement au travail? Supérieur(e)s\",\"labelled\":true},{\"id\":\"Q59c\",\"year\":\"2024\",\"en\":\"Question 59c. From whom did you experience harassment on the job? Individuals working for me\",\"fr\":\"Question 59c. De la part de qui avez-vous été victime de harcèlement au travail? Employé(e)s relevant de moi\",\"labelled\":true},{\"id\":\"Q59d\",\"year\":\"2024\",\"en\":\"Question 59d. From whom did you experience harassment on the job? Individuals for whom I have a custodial responsibility (e.g., inmates, offenders, patients, detainees)\",\"fr\":\"Question 59d. De la part de qui avez-vous été victime de harcèlement au travail? Personnes envers lesquelles j'ai une responsabilité de garde (p. ex. détenu(e)s, contrevenant(e)s, patient(e)s, personnes sous garde)\",\"labelled\":true},{\"id\":\"Q59e\",\"year\":\"2024\",\"en\":\"Question 59e. From whom did you experience harassment on the job? Individuals from other departments or agencies\",\"fr\":\"Question 59e. De la part de qui avez-vous été victime de harcèlement au travail? Personnes provenant d'autres ministères ou organismes\",\"labelled\":true},{\"id\":\"Q59f\",\"year\":\"2024\",\"en\":\"Question 59f. From whom did you experience harassment on the job? Members of the public (individuals or organizations)\",\"fr\":\"Question 59f. De la part de qui avez-vous été victime de harcèlement au travail? Membres du public (personnes ou organisations)\",\"labelled\":true},{\"id\":\"Q59g\",\"year\":\"2024\",\"en\":\"Question 59g. From whom did you experience harassment on the job? Other\",\"fr\":\"Question 59g. De la part de qui avez-vous été victime de harcèlement au travail? Autre\",\"labelled\":true},{\"id\":\"Q60a\",\"year\":\"2024\",\"en\":\"Question 60a. Please indicate the nature of the harassment you experienced. Aggressive behaviour\",\"fr\":\"Question 60a. Veuillez indiquer la nature du harcèlement dont vous avez fait l'objet. Comportement agressif\",\"labelled\":true},{\"id\":\"Q60b\",\"year\":\"2024\",\"en\":\"Question 60b. Please indicate the nature of the harassment you experienced. Excessive control\",\"fr\":\"Question 60b. Veuillez indiquer la nature du harcèlement dont vous avez fait l'objet. Contrôle excessif\",\"labelled\":true},{\"id\":\"Q60c\",\"year\":\"2024\",\"en\":\"Question 60c. Please indicate the nature of the harassment you experienced. Being excluded or being ignored\",\"fr\":\"Question 60c. Veuillez indiquer la nature du harcèlement dont vous avez fait l'objet. Être exclu(e) ou ignoré(e)\",\"labelled\":true},{\"id\":\"Q60d\",\"year\":\"2024\",\"en\":\"Question 60d. Please indicate the nature of the harassment you experienced. Humiliation\",\"fr\":\"Question 60d. Veuillez indiquer la nature du harcèlement dont vous avez fait l'objet. Humiliation\",\"labelled\":true},{\"id\":\"Q60e\",\"year\":\"2024\",\"en\":\"Question 60e. Please indicate the nature of the harassment you experienced. Interference with work or withholding resources\",\"fr\":\"Question 60e. Veuillez indiquer la nature du harcèlement dont vous avez fait l'objet. Interférence dans le travail ou retenue de ressources\",\"labelled\":true},{\"id\":\"Q60f\",\"year\":\"2024\",\"en\":\"Question 60f. Please indicate the nature of the harassment you experienced. Offensive remark\",\"fr\":\"Question 60f. Veuillez indiquer la nature du harcèlement dont vous avez fait l'objet. Commentaire désobligeant\",\"labelled\":true},{\"id\":\"Q60g\",\"year\":\"2024\",\"en\":\"Question 60g. Please indicate the nature of the harassment you experienced. Personal attack\",\"fr\":\"Question 60g. Veuillez indiquer la nature du harcèlement dont vous avez fait l'objet. Attaque personnelle\",\"labelled\":true},{\"id\":\"Q60h\",\"year\":\"2024\",\"en\":\"Question 60h. Please indicate the nature of the harassment you experienced. Physical violence\",\"fr\":\"Question 60h. Veuillez indiquer la nature du harcèlement dont vous avez fait l'objet. Violence physique\",\"labelled\":true},{\"id\":\"Q60i\",\"year\":\"2024\",\"en\":\"Question 60i. Please indicate the nature of the harassment you experienced. Sexual comment or gesture\",\"fr\":\"Question 60i. Veuillez indiquer la nature du harcèlement dont vous avez fait l'objet. Commentaire ou geste à caractère sexuel\",\"labelled\":true},{\"id\":\"Q60j\",\"year\":\"2024\",\"en\":\"Question 60j. Please indicate the nature of the harassment you experienced. Threat\",\"fr\":\"Question 60j. Veuillez indiquer la nature du harcèlement dont vous avez fait l'objet. Menace\",\"labelled\":true},{\"id\":\"Q60k\",\"year\":\"2024\",\"en\":\"Question 60k. Please indicate the nature of the harassment you experienced. Unfair treatment\",\"fr\":\"Question 60k. Veuillez indiquer la nature du harcèlement dont vous avez fait l'objet. Traitement injuste\",\"labelled\":true},{\"id\":\"Q60l\",\"year\":\"2024\",\"en\":\"Question 60l. Please indicate the nature of the harassment you experienced. Yelling or shouting\",\"fr\":\"Question 60l. Veuillez indiquer la nature du harcèlement dont vous avez fait l'objet. Hurlement ou cris\",\"labelled\":true},{\"id\":\"Q60m\",\"year\":\"2024\",\"en\":\"Question 60m. Please indicate the nature of the harassment you experienced. Other\",\"fr\":\"Question 60m. Veuillez indiquer la nature du harcèlement dont vous avez fait l'objet. Autre\",\"labelled\":true},{\"id\":\"Q61a\",\"year\":\"2024\",\"en\":\"Question 61a. What action(s) did you take to address the harassment you experienced? I discussed the matter with my supervisor or a senior manager.\",\"fr\":\"Question 61a. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de harcèlement dont vous avez fait l'objet? J'ai discuté du problème avec mon (ma) superviseur(e) ou un(e) cadre supérieur(e).\",\"labelled\":true},{\"id\":\"Q61b\",\"year\":\"2024\",\"en\":\"Question 61b. What action(s) did you take to address the harassment you experienced? I discussed the matter with the person(s) from whom I experienced the harassment.\",\"fr\":\"Question 61b. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de harcèlement dont vous avez fait l'objet? J'ai discuté du problème avec la ou les personne(s) par laquelle (lesquelles) j'ai été harcelé(e).\",\"labelled\":true},{\"id\":\"Q61c\",\"year\":\"2024\",\"en\":\"Question 61c. What action(s) did you take to address the harassment you experienced? I contacted a human resources advisor in my department or agency.\",\"fr\":\"Question 61c. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de harcèlement dont vous avez fait l'objet? J'ai communiqué avec un(e) conseiller(ère) en ressources humaines de mon ministère ou organisme.\",\"labelled\":true},{\"id\":\"Q61d\",\"year\":\"2024\",\"en\":\"Question 61d. What action(s) did you take to address the harassment you experienced? I contacted my union representative.\",\"fr\":\"Question 61d. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de harcèlement dont vous avez fait l'objet? J'ai communiqué avec mon (ma) représentant(e) syndical(e).\",\"labelled\":true},{\"id\":\"Q61e\",\"year\":\"2024\",\"en\":\"Question 61e. What action(s) did you take to address the harassment you experienced? I used an informal conflict resolution process.\",\"fr\":\"Question 61e. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de harcèlement dont vous avez fait l'objet? J'ai eu recours à un processus informel de résolution des conflits.\",\"labelled\":true},{\"id\":\"Q61f\",\"year\":\"2024\",\"en\":\"Question 61f. What action(s) did you take to address the harassment you experienced? I filed a grievance or formal complaint.\",\"fr\":\"Question 61f. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de harcèlement dont vous avez fait l'objet? J'ai déposé un grief ou une plainte officielle.\",\"labelled\":true},{\"id\":\"Q61g\",\"year\":\"2024\",\"en\":\"Question 61g. What action(s) did you take to address the harassment you experienced? I resolved the matter informally on my own.\",\"fr\":\"Question 61g. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de harcèlement dont vous avez fait l'objet? J'ai réglé la question de façon informelle par moi-même.\",\"labelled\":true},{\"id\":\"Q61h\",\"year\":\"2024\",\"en\":\"Question 61h. What action(s) did you take to address the harassment you experienced? Other\",\"fr\":\"Question 61h. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de harcèlement dont vous avez fait l'objet? Autre\",\"labelled\":true},{\"id\":\"Q61i\",\"year\":\"2024\",\"en\":\"Question 61i. What action(s) did you take to address the harassment you experienced? I took no action.\",\"fr\":\"Question 61i. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de harcèlement dont vous avez fait l'objet? Je n'ai pris aucune mesure.\",\"labelled\":true},{\"id\":\"Q62a\",\"year\":\"2024\",\"en\":\"Question 62a. Why did you not file a grievance or formal complaint about the harassment you experienced? The issue was resolved.\",\"fr\":\"Question 62a. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? La situation a été réglée.\",\"labelled\":true},{\"id\":\"Q62b\",\"year\":\"2024\",\"en\":\"Question 62b. Why did you not file a grievance or formal complaint about the harassment you experienced? I did not think the incident was serious enough.\",\"fr\":\"Question 62b. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? Je ne pensais pas que l'incident était assez grave.\",\"labelled\":true},{\"id\":\"Q62c\",\"year\":\"2024\",\"en\":\"Question 62c. Why did you not file a grievance or formal complaint about the harassment you experienced? The behaviour stopped.\",\"fr\":\"Question 62c. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? Le comportement s'est arrêté.\",\"labelled\":true},{\"id\":\"Q62d\",\"year\":\"2024\",\"en\":\"Question 62d. Why did you not file a grievance or formal complaint about the harassment you experienced? The individual apologized.\",\"fr\":\"Question 62d. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? La personne s'est excusée.\",\"labelled\":true},{\"id\":\"Q62e\",\"year\":\"2024\",\"en\":\"Question 62e. Why did you not file a grievance or formal complaint about the harassment you experienced? Management intervened.\",\"fr\":\"Question 62e. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? La direction est intervenue.\",\"labelled\":true},{\"id\":\"Q62f\",\"year\":\"2024\",\"en\":\"Question 62f. Why did you not file a grievance or formal complaint about the harassment you experienced? The individual left or changed jobs.\",\"fr\":\"Question 62f. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? La personne a quitté ou changé d'emploi.\",\"labelled\":true},{\"id\":\"Q62g\",\"year\":\"2024\",\"en\":\"Question 62g. Why did you not file a grievance or formal complaint about the harassment you experienced? I changed jobs.\",\"fr\":\"Question 62g. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? J'ai changé d'emploi.\",\"labelled\":true},{\"id\":\"Q62h\",\"year\":\"2024\",\"en\":\"Question 62h. Why did you not file a grievance or formal complaint about the harassment you experienced? I did not know what to do, where to go or whom to ask.\",\"fr\":\"Question 62h. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? Je ne savais pas quoi faire, où aller ou à qui parler.\",\"labelled\":true},{\"id\":\"Q62i\",\"year\":\"2024\",\"en\":\"Question 62i. Why did you not file a grievance or formal complaint about the harassment you experienced? I was too distraught.\",\"fr\":\"Question 62i. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? J'étais trop bouleversé(e).\",\"labelled\":true},{\"id\":\"Q62j\",\"year\":\"2024\",\"en\":\"Question 62j. Why did you not file a grievance or formal complaint about the harassment you experienced? I had concerns about the formal complaint process (e.g., confidentiality, how long it would take).\",\"fr\":\"Question 62j. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? J'avais des préoccupations au sujet du processus formel de plaintes (p. ex. la confidentialité, le temps que prendrait le processus).\",\"labelled\":true},{\"id\":\"Q62k\",\"year\":\"2024\",\"en\":\"Question 62k. Why did you not file a grievance or formal complaint about the harassment you experienced? I was advised against filing a complaint.\",\"fr\":\"Question 62k. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? On m'a conseillé(e) d'éviter de déposer une plainte.\",\"labelled\":true},{\"id\":\"Q62l\",\"year\":\"2024\",\"en\":\"Question 62l. Why did you not file a grievance or formal complaint about the harassment you experienced? I was afraid of reprisal (e.g., having limited career advancement, being labelled a troublemaker).\",\"fr\":\"Question 62l. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? J'avais peur des représailles (p. ex. limiter l'avancement de ma carrière ou porter l'étiquette de fauteur(-euse) de troubles).\",\"labelled\":true},{\"id\":\"Q62m\",\"year\":\"2024\",\"en\":\"Question 62m. Why did you not file a grievance or formal complaint about the harassment you experienced? Someone threatened me.\",\"fr\":\"Question 62m. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? Quelqu'un m'a menacé(e).\",\"labelled\":true},{\"id\":\"Q62n\",\"year\":\"2024\",\"en\":\"Question 62n. Why did you not file a grievance or formal complaint about the harassment you experienced? I did not believe it would make a difference.\",\"fr\":\"Question 62n. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? Je ne croyais pas que cela ferait une différence.\",\"labelled\":true},{\"id\":\"Q62o\",\"year\":\"2024\",\"en\":\"Question 62o. Why did you not file a grievance or formal complaint about the harassment you experienced? I intend to file a grievance or a formal complaint, but I have not done so yet.\",\"fr\":\"Question 62o. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? J'ai l'intention de déposer un grief ou une plainte officielle mais je ne l'ai pas encore fait.\",\"labelled\":true},{\"id\":\"Q62p\",\"year\":\"2024\",\"en\":\"Question 62p. Why did you not file a grievance or formal complaint about the harassment you experienced? Other\",\"fr\":\"Question 62p. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant le harcèlement dont vous avez fait l'objet? Autre\",\"labelled\":true},{\"id\":\"Q63\",\"year\":\"2024\",\"en\":\"Question 63. I am satisfied with how matters related to harassment are resolved in my department or agency.\",\"fr\":\"Question 63. Je suis satisfait(e) de la manière dont les problèmes de harcèlement sont réglés dans mon ministère ou organisme.\",\"labelled\":true},{\"id\":\"Q64\",\"year\":\"2024\",\"en\":\"Question 64. My department or agency works hard to create a workplace that prevents harassment.\",\"fr\":\"Question 64. Mon ministère ou organisme met tout en œuvre pour créer un milieu de travail qui prévient le harcèlement.\",\"labelled\":true},{\"id\":\"Q65\",\"year\":\"2024\",\"en\":\"Question 65. Having carefully read the definition of discrimination above, have you been the victim of discrimination on the job in the past 12 months?\",\"fr\":\"Question 65. Après avoir lu attentivement la définition de la discrimination ci-dessus, au cours des 12 derniers mois, avez-vous été victime de discrimination au travail?\",\"labelled\":true},{\"id\":\"Q66a\",\"year\":\"2024\",\"en\":\"Question 66a. From whom did you experience discrimination on the job? Co-workers\",\"fr\":\"Question 66a. De la part de qui avez-vous été victime de discrimination au travail? Collègues\",\"labelled\":true},{\"id\":\"Q66b\",\"year\":\"2024\",\"en\":\"Question 66b. From whom did you experience discrimination on the job? Individuals with authority over me\",\"fr\":\"Question 66b. De la part de qui avez-vous été victime de discrimination au travail? Supérieur(e)s\",\"labelled\":true},{\"id\":\"Q66c\",\"year\":\"2024\",\"en\":\"Question 66c. From whom did you experience discrimination on the job? Individuals working for me\",\"fr\":\"Question 66c. De la part de qui avez-vous été victime de discrimination au travail? Employé(e)s relevant de moi\",\"labelled\":true},{\"id\":\"Q66d\",\"year\":\"2024\",\"en\":\"Question 66d. From whom did you experience discrimination on the job? Individuals for whom I have a custodial responsibility (e.g., inmates, offenders, patients, detainees)\",\"fr\":\"Question 66d. De la part de qui avez-vous été victime de discrimination au travail? Personnes envers lesquelles j'ai une responsabilité de garde (p. ex. détenu(e)s, contrevenant(e)s, patient(e)s, personnes sous garde)\",\"labelled\":true},{\"id\":\"Q66e\",\"year\":\"2024\",\"en\":\"Question 66e. From whom did you experience discrimination on the job? Individuals from other departments or agencies\",\"fr\":\"Question 66e. De la part de qui avez-vous été victime de discrimination au travail? Personnes provenant d'autres ministères ou organismes\",\"labelled\":true},{\"id\":\"Q66f\",\"year\":\"2024\",\"en\":\"Question 66f. From whom did you experience discrimination on the job? Members of the public (individuals or organizations)\",\"fr\":\"Question 66f. De la part de qui avez-vous été victime de discrimination au travail? Membres du public (personnes ou organisations)\",\"labelled\":true},{\"id\":\"Q66g\",\"year\":\"2024\",\"en\":\"Question 66g. From whom did you experience discrimination on the job? Other\",\"fr\":\"Question 66g. De la part de qui avez-vous été victime de discrimination au travail? Autre\",\"labelled\":true},{\"id\":\"Q67a\",\"year\":\"2024\",\"en\":\"Question 67a. Please indicate the type of discrimination you experienced. Race\",\"fr\":\"Question 67a. Veuillez indiquer le type de discrimination dont vous avez fait l'objet. Race\",\"labelled\":true},{\"id\":\"Q67b\",\"year\":\"2024\",\"en\":\"Question 67b. Please indicate the type of discrimination you experienced. National or ethnic origin\",\"fr\":\"Question 67b. Veuillez indiquer le type de discrimination dont vous avez fait l'objet. Origine nationale ou ethnique\",\"labelled\":true},{\"id\":\"Q67c\",\"year\":\"2024\",\"en\":\"Question 67c. Please indicate the type of discrimination you experienced. Colour\",\"fr\":\"Question 67c. Veuillez indiquer le type de discrimination dont vous avez fait l'objet. Couleur\",\"labelled\":true},{\"id\":\"Q67d\",\"year\":\"2024\",\"en\":\"Question 67d. Please indicate the type of discrimination you experienced. Religion\",\"fr\":\"Question 67d. Veuillez indiquer le type de discrimination dont vous avez fait l'objet. Religion\",\"labelled\":true},{\"id\":\"Q67e\",\"year\":\"2024\",\"en\":\"Question 67e. Please indicate the type of discrimination you experienced. Age\",\"fr\":\"Question 67e. Veuillez indiquer le type de discrimination dont vous avez fait l'objet. Âge\",\"labelled\":true},{\"id\":\"Q67f\",\"year\":\"2024\",\"en\":\"Question 67f. Please indicate the type of discrimination you experienced. Sex\",\"fr\":\"Question 67f. Veuillez indiquer le type de discrimination dont vous avez fait l'objet. Sexe\",\"labelled\":true},{\"id\":\"Q67g\",\"year\":\"2024\",\"en\":\"Question 67g. Please indicate the type of discrimination you experienced. Sexual orientation\",\"fr\":\"Question 67g. Veuillez indiquer le type de discrimination dont vous avez fait l'objet. Orientation sexuelle\",\"labelled\":true},{\"id\":\"Q67h\",\"year\":\"2024\",\"en\":\"Question 67h. Please indicate the type of discrimination you experienced. Gender identity or expression (including gender diverse identities or expressions such as transgender, two-spirit or non-binary)\",\"fr\":\"Question 67h. Veuillez indiquer le type de discrimination dont vous avez fait l'objet. Identité ou expression de genre (incluant l'identité ou l'expression de divers genres telle que transgenre, bispirituelle ou non-binaire)\",\"labelled\":true},{\"id\":\"Q67i\",\"year\":\"2024\",\"en\":\"Question 67i. Please indicate the type of discrimination you experienced. Marital status\",\"fr\":\"Question 67i. Veuillez indiquer le type de discrimination dont vous avez fait l'objet. État matrimonial\",\"labelled\":true},{\"id\":\"Q67j\",\"year\":\"2024\",\"en\":\"Question 67j. Please indicate the type of discrimination you experienced. Family status\",\"fr\":\"Question 67j. Veuillez indiquer le type de discrimination dont vous avez fait l'objet. Situation familiale\",\"labelled\":true},{\"id\":\"Q67k\",\"year\":\"2024\",\"en\":\"Question 67k. Please indicate the type of discrimination you experienced. Genetic characteristics (including a requirement to undergo a genetic test or disclose the results of a genetic test)\",\"fr\":\"Question 67k. Veuillez indiquer le type de discrimination dont vous avez fait l'objet. Caractéristiques génétiques (y compris l'obligation de subir un test génétique ou à communiquer les résultats d'un test génétique)\",\"labelled\":true},{\"id\":\"Q67l\",\"year\":\"2024\",\"en\":\"Question 67l. Please indicate the type of discrimination you experienced. Disability\",\"fr\":\"Question 67l. Veuillez indiquer le type de discrimination dont vous avez fait l'objet. Déficience (ou handicap)\",\"labelled\":true},{\"id\":\"Q67m\",\"year\":\"2024\",\"en\":\"Question 67m. Please indicate the type of discrimination you experienced. Pardoned conviction or suspended record\",\"fr\":\"Question 67m. Veuillez indiquer le type de discrimination dont vous avez fait l'objet. État de personne graciée\",\"labelled\":true},{\"id\":\"Q68a\",\"year\":\"2024\",\"en\":\"Question 68a. What action(s) did you take to address the discrimination you experienced? I discussed the matter with my supervisor or a senior manager.\",\"fr\":\"Question 68a. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de discrimination dont vous avez fait l'objet? J'ai discuté du problème avec mon (ma) superviseur(e) ou un(e) cadre supérieur(e).\",\"labelled\":true},{\"id\":\"Q68b\",\"year\":\"2024\",\"en\":\"Question 68b. What action(s) did you take to address the discrimination you experienced? I discussed the matter with the person(s) from whom I experienced the discrimination.\",\"fr\":\"Question 68b. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de discrimination dont vous avez fait l'objet? J'ai discuté du problème avec la ou les personne(s) par laquelle (lesquelles) j'ai été discriminé(e).\",\"labelled\":true},{\"id\":\"Q68c\",\"year\":\"2024\",\"en\":\"Question 68c. What action(s) did you take to address the discrimination you experienced? I contacted a human resources advisor in my department or agency.\",\"fr\":\"Question 68c. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de discrimination dont vous avez fait l'objet? J'ai communiqué avec un(e) conseiller(ère) en ressources humaines de mon ministère ou organisme.\",\"labelled\":true},{\"id\":\"Q68d\",\"year\":\"2024\",\"en\":\"Question 68d. What action(s) did you take to address the discrimination you experienced? I contacted my union representative.\",\"fr\":\"Question 68d. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de discrimination dont vous avez fait l'objet? J'ai communiqué avec mon (ma) représentant(e) syndical(e).\",\"labelled\":true},{\"id\":\"Q68e\",\"year\":\"2024\",\"en\":\"Question 68e. What action(s) did you take to address the discrimination you experienced? I used an informal conflict resolution process.\",\"fr\":\"Question 68e. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de discrimination dont vous avez fait l'objet? J'ai eu recours à un processus informel de résolution des conflits.\",\"labelled\":true},{\"id\":\"Q68f\",\"year\":\"2024\",\"en\":\"Question 68f. What action(s) did you take to address the discrimination you experienced? I filed a grievance or formal complaint.\",\"fr\":\"Question 68f. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de discrimination dont vous avez fait l'objet? J'ai déposé un grief ou une plainte officielle.\",\"labelled\":true},{\"id\":\"Q68g\",\"year\":\"2024\",\"en\":\"Question 68g. What action(s) did you take to address the discrimination you experienced? I resolved the matter informally on my own.\",\"fr\":\"Question 68g. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de discrimination dont vous avez fait l'objet? J'ai réglé la question de façon informelle par moi-même.\",\"labelled\":true},{\"id\":\"Q68h\",\"year\":\"2024\",\"en\":\"Question 68h. What action(s) did you take to address the discrimination you experienced? Other\",\"fr\":\"Question 68h. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de discrimination dont vous avez fait l'objet? Autre\",\"labelled\":true},{\"id\":\"Q68i\",\"year\":\"2024\",\"en\":\"Question 68i. What action(s) did you take to address the discrimination you experienced? I took no action.\",\"fr\":\"Question 68i. Quelle(s) mesure(s) avez-vous prise(s) pour régler le problème de discrimination dont vous avez fait l'objet? Je n'ai pris aucune mesure.\",\"labelled\":true},{\"id\":\"Q69a\",\"year\":\"2024\",\"en\":\"Question 69a. Why did you not file a grievance or formal complaint about the discrimination you experienced? The issue was resolved.\",\"fr\":\"Question 69a. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? La situation a été réglée.\",\"labelled\":true},{\"id\":\"Q69b\",\"year\":\"2024\",\"en\":\"Question 69b. Why did you not file a grievance or formal complaint about the discrimination you experienced? I did not think the incident was serious enough.\",\"fr\":\"Question 69b. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? Je ne pensais pas que l'incident était assez grave.\",\"labelled\":true},{\"id\":\"Q69c\",\"year\":\"2024\",\"en\":\"Question 69c. Why did you not file a grievance or formal complaint about the discrimination you experienced? The behaviour stopped.\",\"fr\":\"Question 69c. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? Le comportement s'est arrêté.\",\"labelled\":true},{\"id\":\"Q69d\",\"year\":\"2024\",\"en\":\"Question 69d. Why did you not file a grievance or formal complaint about the discrimination you experienced? The individual apologized.\",\"fr\":\"Question 69d. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? La personne s'est excusée.\",\"labelled\":true},{\"id\":\"Q69e\",\"year\":\"2024\",\"en\":\"Question 69e. Why did you not file a grievance or formal complaint about the discrimination you experienced? Management intervened.\",\"fr\":\"Question 69e. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? La direction est intervenue.\",\"labelled\":true},{\"id\":\"Q69f\",\"year\":\"2024\",\"en\":\"Question 69f. Why did you not file a grievance or formal complaint about the discrimination you experienced? The individual left or changed jobs.\",\"fr\":\"Question 69f. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? La personne a quitté ou changé d'emploi.\",\"labelled\":true},{\"id\":\"Q69g\",\"year\":\"2024\",\"en\":\"Question 69g. Why did you not file a grievance or formal complaint about the discrimination you experienced? I changed jobs.\",\"fr\":\"Question 69g. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? J'ai changé d'emploi.\",\"labelled\":true},{\"id\":\"Q69h\",\"year\":\"2024\",\"en\":\"Question 69h. Why did you not file a grievance or formal complaint about the discrimination you experienced? I did not know what to do, where to go or whom to ask.\",\"fr\":\"Question 69h. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? Je ne savais pas quoi faire, où aller ou à qui parler.\",\"labelled\":true},{\"id\":\"Q69i\",\"year\":\"2024\",\"en\":\"Question 69i. Why did you not file a grievance or formal complaint about the discrimination you experienced? I was too distraught.\",\"fr\":\"Question 69i. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? J'étais trop bouleversé(e).\",\"labelled\":true},{\"id\":\"Q69j\",\"year\":\"2024\",\"en\":\"Question 69j. Why did you not file a grievance or formal complaint about the discrimination you experienced? I had concerns about the formal complaint process (e.g., confidentiality, how long it would take).\",\"fr\":\"Question 69j. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? J'avais des préoccupations au sujet du processus formel de plaintes (p. ex. la confidentialité, le temps que prendrait le processus).\",\"labelled\":true},{\"id\":\"Q69k\",\"year\":\"2024\",\"en\":\"Question 69k. Why did you not file a grievance or formal complaint about the discrimination you experienced? I was advised against filing a complaint.\",\"fr\":\"Question 69k. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? On m'a conseillé d'éviter de déposer une plainte.\",\"labelled\":true},{\"id\":\"Q69l\",\"year\":\"2024\",\"en\":\"Question 69l. Why did you not file a grievance or formal complaint about the discrimination you experienced? I was afraid of reprisal (e.g., having limited career advancement, being labelled a troublemaker).\",\"fr\":\"Question 69l. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? J'avais peur des représailles (p. ex. limiter l'avancement de ma carrière ou porter l'étiquette de fauteur(-euse) de troubles).\",\"labelled\":true},{\"id\":\"Q69m\",\"year\":\"2024\",\"en\":\"Question 69m. Why did you not file a grievance or formal complaint about the discrimination you experienced? Someone threatened me.\",\"fr\":\"Question 69m. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? Quelqu'un m'a menacé(e).\",\"labelled\":true},{\"id\":\"Q69n\",\"year\":\"2024\",\"en\":\"Question 69n. Why did you not file a grievance or formal complaint about the discrimination you experienced? I did not believe it would make a difference.\",\"fr\":\"Question 69n. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? Je ne croyais pas que cela ferait une différence.\",\"labelled\":true},{\"id\":\"Q69o\",\"year\":\"2024\",\"en\":\"Question 69o. Why did you not file a grievance or formal complaint about the discrimination you experienced? I intend to file a grievance or a formal complaint, but I have not done so yet.\",\"fr\":\"Question 69o. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? J'ai l'intention de déposer un grief ou une plainte officielle, mais je ne l'ai pas encore fait.\",\"labelled\":true},{\"id\":\"Q69p\",\"year\":\"2024\",\"en\":\"Question 69p. Why did you not file a grievance or formal complaint about the discrimination you experienced? Other\",\"fr\":\"Question 69p. Pourquoi n'avez-vous pas déposé un grief ou une plainte officielle concernant la discrimination dont vous avez fait l'objet? Autre\",\"labelled\":true},{\"id\":\"Q70\",\"year\":\"2024\",\"en\":\"Question 70. I am satisfied with how matters related to discrimination are resolved in my department or agency.\",\"fr\":\"Question 70. Je suis satisfait(e) de la manière dont les problèmes de discrimination sont réglés dans mon ministère ou organisme.\",\"labelled\":true},{\"id\":\"Q71\",\"year\":\"2024\",\"en\":\"Question 71. My department or agency works hard to create a workplace that prevents discrimination.\",\"fr\":\"Question 71. Mon ministère ou organisme met tout en œuvre pour créer un milieu de travail qui prévient la discrimination.\",\"labelled\":true},{\"id\":\"Q72\",\"year\":\"2024\",\"en\":\"Question 72. I am satisfied with how concerns or complaints about racism in the workplace are resolved in my department or agency.\",\"fr\":\"Question 72. Je suis satisfait(e) de la façon dont les préoccupations ou les plaintes au sujet du racisme en milieu de travail sont réglées par mon ministère ou organisme.\",\"labelled\":true},{\"id\":\"Q73a\",\"year\":\"2024\",\"en\":\"Question 73a. Overall, to what extent do the following factors cause you work-related stress? Pay or other compensation-related issues\",\"fr\":\"Question 73a. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Problèmes liés à la paye ou à d'autres aspects de la rémunération\",\"labelled\":true},{\"id\":\"Q73b\",\"year\":\"2024\",\"en\":\"Question 73b. Overall, to what extent do the following factors cause you work-related stress? Heavy workload\",\"fr\":\"Question 73b. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Lourde charge de travail\",\"labelled\":true},{\"id\":\"Q73c\",\"year\":\"2024\",\"en\":\"Question 73c. Overall, to what extent do the following factors cause you work-related stress? Unreasonable deadlines\",\"fr\":\"Question 73c. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Délais déraisonnables\",\"labelled\":true},{\"id\":\"Q73d\",\"year\":\"2024\",\"en\":\"Question 73d. Overall, to what extent do the following factors cause you work-related stress? Not enough employees to do the work\",\"fr\":\"Question 73d. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Pas assez d'employé(e)s pour faire le travail\",\"labelled\":true},{\"id\":\"Q73e\",\"year\":\"2024\",\"en\":\"Question 73e. Overall, to what extent do the following factors cause you work-related stress? Overtime or long work hours\",\"fr\":\"Question 73e. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Heures supplémentaires ou longues heures de travail\",\"labelled\":true},{\"id\":\"Q73f\",\"year\":\"2024\",\"en\":\"Question 73f. Overall, to what extent do the following factors cause you work-related stress? Balancing work and personal life\",\"fr\":\"Question 73f. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Conciliation travail et vie personnelle\",\"labelled\":true},{\"id\":\"Q73g\",\"year\":\"2024\",\"en\":\"Question 73g. Overall, to what extent do the following factors cause you work-related stress? Lack of control or input in decision-making\",\"fr\":\"Question 73g. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Manque de contrôle ou de contribution aux prises de décision\",\"labelled\":true},{\"id\":\"Q73h\",\"year\":\"2024\",\"en\":\"Question 73h. Overall, to what extent do the following factors cause you work-related stress? Competing or constantly changing priorities\",\"fr\":\"Question 73h. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Priorités concurrentes ou qui changent constamment\",\"labelled\":true},{\"id\":\"Q73i\",\"year\":\"2024\",\"en\":\"Question 73i. Overall, to what extent do the following factors cause you work-related stress? Lack of clear expectations\",\"fr\":\"Question 73i. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Manque d'attentes claires\",\"labelled\":true},{\"id\":\"Q73j\",\"year\":\"2024\",\"en\":\"Question 73j. Overall, to what extent do the following factors cause you work-related stress? Lack of recognition\",\"fr\":\"Question 73j. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Manque de reconnaissance\",\"labelled\":true},{\"id\":\"Q73k\",\"year\":\"2024\",\"en\":\"Question 73k. Overall, to what extent do the following factors cause you work-related stress? Feeling disconnected from colleagues\",\"fr\":\"Question 73k. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Se sentir déconnecté(e) de ses collègues\",\"labelled\":true},{\"id\":\"Q73l\",\"year\":\"2024\",\"en\":\"Question 73l. Overall, to what extent do the following factors cause you work-related stress? Information overload\",\"fr\":\"Question 73l. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Surcharge d'information\",\"labelled\":true},{\"id\":\"Q73m\",\"year\":\"2024\",\"en\":\"Question 73m. Overall, to what extent do the following factors cause you work-related stress? Physical work environment\",\"fr\":\"Question 73m. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Environnement de travail physique\",\"labelled\":true},{\"id\":\"Q73n\",\"year\":\"2024\",\"en\":\"Question 73n. Overall, to what extent do the following factors cause you work-related stress? Difficulty accessing my work tools or network (e.g., work email, work device, ergonomic equipment)\",\"fr\":\"Question 73n. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Difficulté à avoir accès à mes outils ou au réseau de travail (p. ex. courriel de travail, appareil de travail, équipement ergonomique)\",\"labelled\":true},{\"id\":\"Q73o\",\"year\":\"2024\",\"en\":\"Question 73o. Overall, to what extent do the following factors cause you work-related stress? Accessibility issues\",\"fr\":\"Question 73o. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Problèmes d'accessibilité\",\"labelled\":true},{\"id\":\"Q73p\",\"year\":\"2024\",\"en\":\"Question 73p. Overall, to what extent do the following factors cause you work-related stress? Accommodation issues\",\"fr\":\"Question 73p. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Problèmes d'adaptation\",\"labelled\":true},{\"id\":\"Q73q\",\"year\":\"2024\",\"en\":\"Question 73q. Overall, to what extent do the following factors cause you work-related stress? Harassment or discrimination\",\"fr\":\"Question 73q. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Harcèlement ou discrimination\",\"labelled\":true},{\"id\":\"Q73r\",\"year\":\"2024\",\"en\":\"Question 73r. Overall, to what extent do the following factors cause you work-related stress? Issues with my co-worker(s)\",\"fr\":\"Question 73r. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Problèmes avec un(e) ou des collègues de travail\",\"labelled\":true},{\"id\":\"Q73s\",\"year\":\"2024\",\"en\":\"Question 73s. Overall, to what extent do the following factors cause you work-related stress? Issues with individual(s) with authority over me\",\"fr\":\"Question 73s. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Problèmes avec un(e) ou des supérieur(e)s\",\"labelled\":true},{\"id\":\"Q73t\",\"year\":\"2024\",\"en\":\"Question 73t. Overall, to what extent do the following factors cause you work-related stress? Issues with individual(s) working for me\",\"fr\":\"Question 73t. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Problèmes avec une ou des personne(s) relevant de moi\",\"labelled\":true},{\"id\":\"Q73u\",\"year\":\"2024\",\"en\":\"Question 73u. Overall, to what extent do the following factors cause you work-related stress? Issues with other individual(s) (e.g., members of the public, individuals from other departments or agencies)\",\"fr\":\"Question 73u. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Problèmes avec d'autres personnes (p. ex. des membres du public, personnes d'autres ministères ou organismes)\",\"labelled\":true},{\"id\":\"Q73v\",\"year\":\"2024\",\"en\":\"Question 73v. Overall, to what extent do the following factors cause you work-related stress? Lack of job security\",\"fr\":\"Question 73v. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Manque de sécurité d'emploi\",\"labelled\":true},{\"id\":\"Q73w\",\"year\":\"2024\",\"en\":\"Question 73w. Overall, to what extent do the following factors cause you work-related stress? Personal issues\",\"fr\":\"Question 73w. Dans l'ensemble, dans quelle mesure les facteurs suivants vous causent-ils du stress au travail? Problèmes personnels\",\"labelled\":true},{\"id\":\"Q74\",\"year\":\"2024\",\"en\":\"Question 74. Overall, my level of work-related stress is...\",\"fr\":\"Question 74. Dans l'ensemble, mon niveau de stress lié au travail est...\",\"labelled\":true},{\"id\":\"Q75\",\"year\":\"2024\",\"en\":\"Question 75. After my workday, I feel emotionally drained.\",\"fr\":\"Question 75. Après ma journée de travail, je me sens épuisé(e) émotionnellement.\",\"labelled\":true},{\"id\":\"Q76\",\"year\":\"2024\",\"en\":\"Question 76. My department or agency does a good job of raising awareness of mental health in the workplace.\",\"fr\":\"Question 76. Mon ministère ou organisme fait un bon travail de sensibilisation à la santé mentale en milieu de travail.\",\"labelled\":true},{\"id\":\"Q77\",\"year\":\"2024\",\"en\":\"Question 77. In general, how is your mental health?\",\"fr\":\"Question 77. En général, comment est votre santé mentale?\",\"labelled\":true},{\"id\":\"Q78\",\"year\":\"2024\",\"en\":\"Question 78. My immediate supervisor supports my mental health and well-being.\",\"fr\":\"Question 78. Mon (ma) superviseur(e) immédiat(e) soutient ma santé mentale et mon bien-être.\",\"labelled\":true},{\"id\":\"Q79\",\"year\":\"2024\",\"en\":\"Question 79. I would feel comfortable sharing concerns with my immediate supervisor about my mental health.\",\"fr\":\"Question 79. Je me sentirais à l'aise de faire part à mon (ma) superviseur(e) immédiat(e) de mes préoccupations à propos de ma santé mentale.\",\"labelled\":true},{\"id\":\"Q80\",\"year\":\"2024\",\"en\":\"Question 80. I would feel comfortable sharing concerns with my immediate supervisor about my physical health and safety.\",\"fr\":\"Question 80. Je me sentirais à l'aise de faire part à mon (ma) superviseur(e) immédiat(e) de mes préoccupations à propos de ma santé physique et ma sécurité.\",\"labelled\":true},{\"id\":\"Q81\",\"year\":\"2024\",\"en\":\"Question 81. I would describe my workplace as being psychologically healthy.\",\"fr\":\"Question 81. Je dirais que mon milieu de travail est sain sur le plan psychologique.\",\"labelled\":true},{\"id\":\"Q83\",\"year\":\"2024\",\"en\":\"Question 83. I am equipped to support employees in my work unit who are experiencing mental health issues.\",\"fr\":\"Question 83. Je suis outillé(e) pour aider les employé(e)s de mon unité de travail qui ont des problèmes de santé mentale.\",\"labelled\":true},{\"id\":\"Q84\",\"year\":\"2024\",\"en\":\"Question 84. Having carefully read the definition of duty to accommodate, have you requested workplace accommodation measures in the last two years?\",\"fr\":\"Question 84. Après avoir lu attentivement la définition de l'obligation de prendre des mesures d'adaptation, au cours des deux dernières années, avez-vous demandé des mesures d'adaptation en milieu de travail?\",\"labelled\":true},{\"id\":\"Q85\",\"year\":\"2024\",\"en\":\"Question 85. Were the requests for workplace accommodation measures related to a disability?\",\"fr\":\"Question 85. Les mesures d'adaptation en milieu de travail qui ont fait l'objet d'une demande étaient-elles liées à une incapacité?\",\"labelled\":true},{\"id\":\"Q86\",\"year\":\"2024\",\"en\":\"Question 86. Were any workplace accommodation measures implemented?\",\"fr\":\"Question 86. Est-ce que des mesures d'adaptation quelconques ont été prises?\",\"labelled\":true},{\"id\":\"Q87\",\"year\":\"2024\",\"en\":\"Question 87. I am satisfied with the workplace accommodation measures that were implemented.\",\"fr\":\"Question 87. Je suis satisfait(e) par les mesures d'adaptation en milieu de travail qui ont été prises.\",\"labelled\":true},{\"id\":\"Q88\",\"year\":\"2024\",\"en\":\"Question 88. I would feel comfortable requesting workplace accommodation measures from my immediate supervisor.\",\"fr\":\"Question 88. Je me sentirais à l'aise de demander des mesures d'adaptation en milieu de travail auprès de mon (ma) superviseur(e) immédiat(e).\",\"labelled\":true},{\"id\":\"Q89\",\"year\":\"2024\",\"en\":\"Question 89. In the last 12 months, has your pay or other compensation been affected by issues with the Phoenix pay system?\",\"fr\":\"Question 89. Au cours des 12 derniers mois, votre paye ou autre rémunération a-t-elle été touchée par les problèmes liés au système de paye Phénix?\",\"labelled\":true},{\"id\":\"Q90\",\"year\":\"2024\",\"en\":\"Question 90. Have all your pay or other compensation issues been resolved?\",\"fr\":\"Question 90. Est-ce que tous vos problèmes de paye ou autre rémunération ont été réglés?\",\"labelled\":true},{\"id\":\"Q91\",\"year\":\"2024\",\"en\":\"Question 91. I am satisfied with the support (e.g., regular information, follow-up, making enquiries on my behalf, offering emergency or priority pay) I received from my department or agency to help resolve my pay or other compensation issues.\",\"fr\":\"Question 91. Je suis satisfait(e) du soutien (p. ex. information régulière, suivi, demandes de renseignements en mon nom, paiement d'urgence ou paiement prioritaire) que j'ai reçu de la part de mon ministère ou organisme pour m'aider à régler mes problèmes de paye ou autre rémunération.\",\"labelled\":true},{\"id\":\"Q92\",\"year\":\"2024\",\"en\":\"Question 92. I am satisfied with the support I received from the Pay Centre to help resolve my pay or other compensation issues.\",\"fr\":\"Question 92. Je suis satisfait(e) du soutien que j'ai reçu de la part du Centre des services de paye pour m'aider à régler mes problèmes de paye ou autre rémunération.\",\"labelled\":true},{\"id\":\"Q93\",\"year\":\"2024\",\"en\":\"Question 93. To what extent have issues with the Phoenix pay system affected your decision to seek or accept another position (e.g., deployment, promotion, secondment, assignment, acting assignment) within your department or agency or the federal public service?\",\"fr\":\"Question 93. Dans quelle mesure les problèmes liés au système de paye Phénix ont-ils affecté votre décision de chercher ou d'accepter un autre poste (p. ex. mutation, promotion, détachement, affectation, affectation intérimaire) au sein de votre organisation ou de la fonction publique fédérale?\",\"labelled\":true},{\"id\":\"Q01\",\"year\":\"2020\",\"en\":\"Q01\",\"fr\":\"Q01\",\"labelled\":false},{\"id\":\"Q01\",\"year\":\"2022\",\"en\":\"Q01\",\"fr\":\"Q01\",\"labelled\":false},{\"id\":\"Q04\",\"year\":\"2019\",\"en\":\"Q04\",\"fr\":\"Q04\",\"labelled\":false},{\"id\":\"Q04\",\"year\":\"2020\",\"en\":\"Q04\",\"fr\":\"Q04\",\"labelled\":false},{\"id\":\"Q04\",\"year\":\"2022\",\"en\":\"Q04\",\"fr\":\"Q04\",\"labelled\":false},{\"id\":\"Q05\",\"year\":\"2019\",\"en\":\"Q05\",\"fr\":\"Q05\",\"labelled\":false},{\"id\":\"Q05\",\"year\":\"2020\",\"en\":\"Q05\",\"fr\":\"Q05\",\"labelled\":false},{\"id\":\"Q05\",\"year\":\"2022\",\"en\":\"Q05\",\"fr\":\"Q05\",\"labelled\":false},{\"id\":\"Q06\",\"year\":\"2019\",\"en\":\"Q06\",\"fr\":\"Q06\",\"labelled\":false},{\"id\":\"Q06\",\"year\":\"2020\",\"en\":\"Q06\",\"fr\":\"Q06\",\"labelled\":false},{\"id\":\"Q06\",\"year\":\"2022\",\"en\":\"Q06\",\"fr\":\"Q06\",\"labelled\":false},{\"id\":\"Q07\",\"year\":\"2019\",\"en\":\"Q07\",\"fr\":\"Q07\",\"labelled\":false},{\"id\":\"Q07\",\"year\":\"2020\",\"en\":\"Q07\",\"fr\":\"Q07\",\"labelled\":false},{\"id\":\"Q07\",\"year\":\"2022\",\"en\":\"Q07\",\"fr\":\"Q07\",\"labelled\":false},{\"id\":\"Q08\",\"year\":\"2019\",\"en\":\"Q08\",\"fr\":\"Q08\",\"labelled\":false},{\"id\":\"Q08\",\"year\":\"2020\",\"en\":\"Q08\",\"fr\":\"Q08\",\"labelled\":false},{\"id\":\"Q08\",\"year\":\"2022\",\"en\":\"Q08\",\"fr\":\"Q08\",\"labelled\":false},{\"id\":\"Q09\",\"year\":\"2019\",\"en\":\"Q09\",\"fr\":\"Q09\",\"labelled\":false},{\"id\":\"Q09\",\"year\":\"2020\",\"en\":\"Q09\",\"fr\":\"Q09\",\"labelled\":false},{\"id\":\"Q09\",\"year\":\"2022\",\"en\":\"Q09\",\"fr\":\"Q09\",\"labelled\":false},{\"id\":\"Q10\",\"year\":\"2019\",\"en\":\"Q10\",\"fr\":\"Q10\",\"labelled\":false},{\"id\":\"Q10\",\"year\":\"2020\",\"en\":\"Q10\",\"fr\":