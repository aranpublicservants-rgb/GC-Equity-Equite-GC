"20060\",\"19651\",\"7920\",\"11134\",\"19863\",\"10185\",\"21268\",\"8788\",\"8749\",\"17538\",\"9023\",\"8978\",\"18001\",\"18062\",\"23311\",\"15408\",\"20663\",\"20004\",\"23857\",\"23105\",\"9129\",\"16140\",\"7637\",\"13131\",\"15578\",\"15542\",\"14608\",\"14189\",\"11447\",\"15184\",\"14177\",\"14876\",\"13873\",\"14542\",\"14711\",\"14617\",\"13292\",\"13676\",\"15381\",\"13782\",\"15409\",\"15794\",\"16615\",\"10201\",\"16067\",\"16775\",\"13490\",\"7583\",\"14091\",\"16192\",\"16261\",\"15814\",\"18569\",\"7010\",\"5461\",\"7433\",\"7816\",\"7810\",\"6464\",\"6450\",\"6819\",\"9270\",\"10332\",\"10379\",\"5600\",\"10679\",\"11337\",\"6928\",\"10548\",\"10120\",\"10971\",\"10443\",\"9922\",\"10696\",\"10724\",\"10507\",\"9165\",\"11256\",\"9755\",\"11520\",\"6999\",\"10761\",\"11217\",\"10984\",\"9708\",\"5062\",\"10471\",\"13643\",\"13064\",\"6444\",\"14315\",\"14544\",\"14431\",\"14409\",\"12108\",\"11797\",\"11440\",\"11761\",\"11823\",\"11746\",\"9204\",\"11378\",\"7339\",\"14826\",\"12990\",\"6956\",\"7570\",\"7304\",\"6091\",\"8414\",\"6945\",\"8429\",\"8163\",\"8350\",\"7506\",\"7441\",\"8218\",\"5168\",\"7235\",\"6092\",\"6610\",\"7158\",\"7647\",\"9988\",\"8942\",\"9578\",\"9290\",\"9816\",\"10148\",\"9474\",\"10714\",\"9571\",\"9011\",\"11999\",\"8245\",\"11129\",\"12086\",\"6627\",\"6311\",\"6374\",\"6694\",\"7153\",\"5210\",\"5405\",\"8682\",\"8701\",\"8853\",\"8744\",\"8386\",\"8961\",\"8019\",\"5743\",\"9943\",\"8042\",\"8872\",\"10351\",\"11173\",\"10634\",\"5818\",\"6939\",\"7177\",\"7234\",\"7746\",\"7372\",\"7878\",\"8420\",\"5305\",\"7670\",\"7997\",\"7884\",\"7758\",\"7438\",\"9916\",\"9223\",\"9981\",\"9542\",\"4508\",\"6747\",\"6820\",\"6048\",\"6221\",\"6543\",\"7738\",\"7075\",\"6455\",\"7249\",\"8715\",\"8493\",\"8752\",\"8269\",\"5775\",\"4743\",\"6813\",\"5391\",\"4905\",\"4317\",\"5340\",\"4801\",\"5860\",\"7184\",\"6865\",\"7103\",\"7514\",\"7658\",\"10000\",\"6316\",\"10535\",\"10232\",\"10502\",\"10505\",\"8936\",\"8893\",\"8639\",\"9119\",\"7353\",\"6232\",\"5563\",\"6309\",\"7142\",\"8404\",\"7108\",\"8413\",\"5179\",\"6538\",\"6335\",\"7584\",\"6665\",\"7174\",\"8981\",\"5675\",\"6211\",\"7961\",\"7954\",\"7905\",\"8151\",\"4167\"],[\"1\",\"2\",\"3\",\"4\",\"0\",\"7\",\"5\",\"6\",\"8\",\"9\"],[\"Employees\",\"Employees (excluding managers and supervisors)\",\"Hiring managers\",\"Managers\",\"Managers or supervisors who did not hire\",\"Staffing advisors\"],[\"Employés\",\"Employés (excluant les gestionnaires et superviseurs)\",\"Gestionnaires d'embauche\",\"Gestionnaires\",\"Gestionnaires et superviseurs qui n'ont pas effectué d'embauche\",\"Conseillers en dotation\"],[\"Yes\",\"1 dependant\",\"2 dependants\",\"3 dependants\",\"4 dependants or more\",\"No\",\"All respondents\",\"Employees who are members of at least one employment equity group\",\"Not members of an employment equity group\",\"Employees who are members of multiple employment equity groups\",\"Men\",\"Women\",\"Another gender\",\"Cisgender\",\"Two-Spirit\",\"Transgender\",\"Queer\",\"Questioning\",\"Intersex\",\"Gender non-binary\",\"Another gender identity\",\"Prefer not to specify\",\"First Nations\",\"Inuit\",\"Métis\",\"Yes, but prefer not to specify\",\"Indigenous\",\"Non-Indigenous\",\"Married\",\"Living common-law\",\"Separated, but still legally married\",\"Divorced\",\"Single, never married\",\"Widowed\",\"Korean\",\"Japanese\",\"Other groups\",\"South Asian\",\"Chinese\",\"Black\",\"Filipino\",\"Arab\",\"Latin American\",\"Southeast Asian\",\"West Asian\",\"Members of Visible Minorities\",\"Not members of visible minorities\",\"Persons with disabilities\",\"Persons without disabilities\",\"Chronic health condition\",\"Pain-related\",\"Cognitive\",\"Learning\",\"Memory\",\"Developmental (intellectual)\",\"Other\",\"Seeing\",\"Hearing\",\"Speech or communication\",\"Mobility\",\"Flexibility\",\"Dexterity\",\"Mental health\",\"Sensory or environmental\",\"Islam\",\"Hinduism\",\"Buddhism\",\"Sikhism\",\"Judaism\",\"Traditional (North American Indigenous) spirituality\",\"Christianity\",\"Other religion and spiritual traditions\",\"Has a religion\",\"Does not have a religion\",\"Lesbian\",\"Gay\",\"Bisexual\",\"Asexual\",\"Pansexual\",\"Heterosexual\",\"Another sexual orientation\"],[\"Oui\",\"1 personne à charge\",\"2 personnes à charge\",\"3 personnes à charge\",\"4 personnes à charge ou plus\",\"Non\",\"Tous les répondants\",\"Employés membres d'au moins un groupe visé par l'équité en matière d'emploi\",\"Pas membres d'un groupe visé par l'équité en matière d'emploi\",\"Employés membres de plusieurs groupes visés par l'équité en matière d'emploi\",\"Hommes\",\"Femmes\",\"Autre genre\",\"Cisgenre\",\"Bispirituel\",\"Transgenre\",\"Queer\",\"En questionnement\",\"Intersexe\",\"Genre non binaire\",\"Autre identité de genre\",\"Préfère ne pas préciser\",\"Premières Nations\",\"Inuit\",\"Métis\",\"Oui, mais je préfère ne pas préciser\",\"Autochtone\",\"Non-Autochtone\",\"Marié\",\"Conjoint de fait\",\"Séparé, mais toujours légalement marié\",\"Divorcé\",\"Célibataire, jamais marié\",\"Veuf\",\"Coréens\",\"Japonais\",\"Autres\",\"Sud-Asiatiques\",\"Chinois\",\"Noirs\",\"Philippins\",\"Arabes\",\"Latino-Américains\",\"Asiatiques Sud-Est\",\"Asiatiques occidentaux\",\"Membres des minorités visibles\",\"Ne font pas partie de minorités visibles\",\"En situation de handicap\",\"Pas en situation de handicap\",\"Problème de santé chronique\",\"Handicap lié à la douleur\",\"Trouble cognitif\",\"Trouble d'apprentissage\",\"Trouble de la mémoire\",\"Déficience de développement (intellectuelle)\",\"Autre\",\"Trouble de la vision\",\"Trouble de l'audition\",\"Trouble de la parole\",\"Problème de mobilité\",\"Problème de flexibilité\",\"Problème de dextérité\",\"Trouble de santé mentale\",\"Handicap sensoriel ou environnemental\",\"Islam\",\"Hindouisme\",\"Bouddhisme\",\"Sikhisme\",\"Judaïsme\",\"Spiritualité traditionnelle (Autochtone d’Amérique du Nord)\",\"Christianisme\",\"Autre religion et traditions spirituelles\",\"A une religion\",\"N'a pas de religion\",\"Lesbienne\",\"Gai\",\"Bisexuel\",\"Asexuel\",\"Pansexuel\",\"Hétérosexuel\",\"Autre orientation sexuelle\"],[\"STA_01A -- To what extent do you agree with the following statement? Within my work unit, staffing activities are carried out in a transparent way.\",\"STA_01B -- To what extent do you agree with the following statement? Within my work unit, I believe that we hire people who can do the job.\",\"STA_01C -- To what extent do you agree with the following statement? My manager keeps me informed of staffing decisions involving my work unit.\",\"STA_01D -- To what extent do you agree with the following statement? Within my work unit, the advertised job requirements reflect those of the position to be filled.\",\"STA_01E -- To what extent do you agree with the following statement? Within my work unit, the process of selecting a person for a position is done fairly.\",\"STA_01F -- To what extent do you agree with the following statement? Within my work unit, non-advertised appointments are done fairly.\",\"STA_03_1 -- For the statement \\\"Within my work unit, non-advertised appointments are done fairly\\\", you indicated a low level of agreement. Please explain why. Non-advertised appointments are never fair\",\"STA_03_2 -- For the statement \\\"Within my work unit, non-advertised appointments are done fairly\\\", you indicated a low level of agreement. Please explain why. Non-advertised appointments are not transparent\",\"STA_03_3 -- For the statement \\\"Within my work unit, non-advertised appointments are done fairly\\\", you indicated a low level of agreement. Please explain why. Non-advertised appointments depend on who you know\",\"STA_03_4 -- For the statement \\\"Within my work unit, non-advertised appointments are done fairly\\\", you indicated a low level of agreement. Please explain why. Non-advertised appointments are not based on merit\",\"STA_03_5 -- For the statement \\\"Within my work unit, non-advertised appointments are done fairly\\\", you indicated a low level of agreement. Please explain why. Non-advertised appointments are not inclusive\",\"STA_03_6 -- For the statement \\\"Within my work unit, non-advertised appointments are done fairly\\\", you indicated a low level of agreement. Please explain why. Other\",\"STA_04 -- Between April 1, 2024 and March 31, 2025, did you act in a position for a period of 4 months or longer?\",\"STA_05 -- Between April 1, 2024 and March 31, 2025, did you participate in an advertised staffing process for a promotion?\",\"STA_06_1 -- Why did you not participate in a process for a promotion? No promotion opportunities were available\",\"STA_06_2 -- Why did you not participate in a process for a promotion? There was no point in participating because I do not believe that staffing processes are fair\",\"STA_06_3 -- Why did you not participate in a process for a promotion? There was no point in participating because advertised positions were meant for specific persons\",\"STA_06_4 -- Why did you not participate in a process for a promotion? I was not interested because I am satisfied with my current group and level\",\"STA_06_5 -- Why did you not participate in a process for a promotion? I was not interested because I am retiring shortly\",\"STA_06_6 -- Why did you not participate in a process for a promotion? I was not interested because I have no interest in moving to a management or executive position\",\"STA_06_7 -- Why did you not participate in a process for a promotion? I was not interested because I am not geographically mobile\",\"STA_06_8 -- Why did you not participate in a process for a promotion? I was concerned that this move would affect my work-life balance\",\"STA_06_9 -- Why did you not participate in a process for a promotion? I was concerned that I have not been at my current group and level for a long time\",\"STA_06_10 -- Why did you not participate in a process for a promotion? I was concerned that my current accommodation measures may not be accepted in a new position\",\"STA_06_11 -- Why did you not participate in a process for a promotion? I was concerned that I might not be successful\",\"STA_06_12 -- Why did you not participate in a process for a promotion? I was concerned that my pay would be affected by issues with the Phoenix pay system\",\"STA_06_13 -- Why did you not participate in a process for a promotion? I did not qualify because I did not meet the language requirements for the position\",\"STA_06_14 -- Why did you not participate in a process for a promotion? I did not qualify because I did not meet the essential qualifications for the position (for example: education, knowledge, experience)\",\"STA_06_15 -- Why did you not participate in a process for a promotion? Operational requirements of the position did not suit my personal circumstances (for example: willingness and ability to work overtime on a short notice, willingness to travel)\",\"STA_06_16 -- Why did you not participate in a process for a promotion? The application process is burdensome\",\"STA_06_17 -- Why did you not participate in a process for a promotion? Staffing processes take too long to complete\",\"STA_06_18 -- Why did you not participate in a process for a promotion? Concerns related to accessibility\",\"STA_06_19 -- Why did you not participate in a process for a promotion? I don't want to self-declare as part of a staffing process if it's required\",\"STA_06_20 -- Why did you not participate in a process for a promotion? Other reasons\",\"STA_07 -- Other than for a promotion, did you participate in an advertised staffing process between April 1, 2024, and March 31, 2025?\",\"STA_08  -- Between April 1, 2024, and March 31, 2025, did you withdraw from a staffing process because it took too long?\",\"STA_09A -- Did any of the staffing activities in which you participated result in the following? You participated, as a candidate, in a virtual assessment as part of a selection process.\",\"STA_09B -- Did any of the staffing activities in which you participated result in the following? You were placed in a pool of candidates.\",\"STA_09C -- Did any of the staffing activities in which you participated result in the following? You received an offer of appointment.\",\"STA_10 -- Between April 1, 2024, and March 31, 2025, did you use artificial intelligence (for example, ChatGPT, Gemini by Google, Microsoft Copilot) technology as part of any of the staffing processes you participated in?\",\"STA_11_1 -- In what part of the staffing process did you use artificial intelligence technology? Writing a cover letter\",\"STA_11_2 -- In what part of the staffing process did you use artificial intelligence technology? Answering screening questions\",\"STA_11_3 -- In what part of the staffing process did you use artificial intelligence technology? Preparing for an interview\",\"STA_11_4 -- In what part of the staffing process did you use artificial intelligence technology? Writing an exam\",\"STA_11_5 --  In what part of the staffing process did you use artificial intelligence technology? Preparing a resume or CV\",\"STA_11_6 -- In what part of the staffing process did you use artificial intelligence technology? Preparing for a second language evaluation\",\"STA_11_7 -- In what part of the staffing process did you use artificial intelligence technology? Other\",\"STA_12A -- Between April 1, 2024, and March 31, 2025, as part of a staffing process or second language evaluation, did you request any assessment accommodation measures?\",\"STA_12B -- Were any assessment accommodation measures provided?\",\"STA_12C_1 -- What type(s) of accommodation did you request and receive? Extra time to complete an assessment\",\"STA_12C_2 -- What type(s) of accommodation did you request and receive? Assessment shortened or divided into parts/sessions\",\"STA_12C_3 -- What type(s) of accommodation did you request and receive? Assessment done at home\",\"STA_12C_4 -- What type(s) of accommodation did you request and receive? Visual enhancement technology\",\"STA_12C_5 -- What type(s) of accommodation did you request and receive? Visual replacement technology such as a screen reader\",\"STA_12C_6 -- What type(s) of accommodation did you request and receive? Speech recognition software\",\"STA_12C_7 -- What type(s) of accommodation did you request and receive? Use of a private room\",\"STA_12C_8 -- What type(s) of accommodation did you request and receive? Accommodation measures for persons with difficulty hearing\",\"STA_12C_9 -- What type(s) of accommodation did you request and receive? Wheelchair access\",\"STA_12C_10 -- What type(s) of accommodation did you request and receive? Materials/questions provided ahead of time\",\"STA_12C_11 -- What type(s) of accommodation did you request and receive? Break(s) during an assessment\",\"STA_12C_12 -- What type(s) of accommodation did you request and receive? Other\",\"STA_12D -- To what extent were you satisfied with the assessment accommodation provided?\",\"STA_12E -- Between April 1, 2024, and March 31, 2025, as part of a staffing process or second language evaluation, did you need any assessment accommodation measures that you did not request?\",\"STA_12F_1 -- Why did you not request the assessment accommodation measures that you needed? I did not believe that I would receive the accommodation I needed\",\"STA_12F_2 -- Why did you not request the assessment accommodation measures that you needed? I was concerned that making an accommodation request would reduce my chances of succeeding in the appointment process\",\"STA_12F_3 -- Why did you not request the assessment accommodation measures that you needed? The process of obtaining an accommodation takes too much time\",\"STA_12F_4 -- Why did you not request the assessment accommodation measures that you needed? Requesting assessment accommodations is too difficult or complicated\",\"STA_12F_5 -- Why did you not request the assessment accommodation measures that you needed? Other reason(s)\",\"STA_13 -- Do you agree with the following statement? Within my department or agency, staffing processes are conducted in a way that reduces or eliminates biases and barriers that disadvantage persons belonging to any equity-seeking group, in assessment methods used in staffing processes.\",\"STA_14A -- Did you experience any biases and barriers that disadvantaged you in the staffing process?\",\"STA_14B_1 -- Which of the following prohibited grounds of discrimination under the Canadian Human Rights Act (CHRA) were the basis for the disadvantage that you experienced in the staffing process? Race\",\"STA_14B_2 -- Which of the following prohibited grounds of discrimination under the Canadian Human Rights Act (CHRA) were the basis for the disadvantage that you experienced in the staffing process? National or ethnic origin\",\"STA_14B_3 -- Which of the following prohibited grounds of discrimination under the Canadian Human Rights Act (CHRA) were the basis for the disadvantage that you experienced in the staffing process? Colour\",\"STA_14B_4 -- Which of the following prohibited grounds of discrimination under the Canadian Human Rights Act (CHRA) were the basis for the disadvantage that you experienced in the staffing process? Religion\",\"STA_14B_5 -- Which of the following prohibited grounds of discrimination under the Canadian Human Rights Act (CHRA) were the basis for the disadvantage that you experienced in the staffing process? Age\",\"STA_14B_6 -- Which of the following prohibited grounds of discrimination under the Canadian Human Rights Act (CHRA) were the basis for the disadvantage that you experienced in the staffing process? Sex\",\"STA_14B_7 -- Which of the following prohibited grounds of discrimination under the Canadian Human Rights Act (CHRA) were the basis for the disadvantage that you experienced in the staffing process? Sexual orientation\",\"STA_14B_8 -- Which of the following prohibited grounds of discrimination under the Canadian Human Rights Act (CHRA) were the basis for the disadvantage that you experienced in the staffing process? Gender identity or expression\",\"STA_14B_9 -- Which of the following prohibited grounds of discrimination under the Canadian Human Rights Act (CHRA) were the basis for the disadvantage that you experienced in the staffing process? Marital status\",\"STA_14B_10 -- Which of the following prohibited grounds of discrimination under the Canadian Human Rights Act (CHRA) were the basis for the disadvantage that you experienced in the staffing process? Family status\",\"STA_14B_11 -- Which of the following prohibited grounds of discrimination under the Canadian Human Rights Act (CHRA) were the basis for the disadvantage that you experienced in the staffing process? Genetic characteristics\",\"STA_14B_12 -- Which of the following prohibited grounds of discrimination under the Canadian Human Rights Act (CHRA) were the basis for the disadvantage that you experienced in the staffing process? Disability\",\"STA_14B_13 -- Which of the following prohibited grounds of discrimination under the Canadian Human Rights Act (CHRA) were the basis for the disadvantage that you experienced in the staffing process? Conviction for an offence for which a pardon has been granted or in respect of which a record suspension has been ordered\",\"STA_14B_99 -- Which of the following prohibited grounds of discrimination under the Canadian Human Rights Act (CHRA) were the basis for the disadvantage that you experienced in the staffing process? Don't know\",\"STA_14C_1 -- In what part of the staffing process did you feel you experienced biases or barriers? Job application\",\"STA_14C_2 -- In what part of the staffing process did you feel you experienced biases or barriers? Automated screening\",\"STA_14C_3 -- In what part of the staffing process did you feel you experienced biases or barriers? Organizational screening\",\"STA_14C_4 -- In what part of the staffing process did you feel you experienced biases or barriers? Written exam\",\"STA_14C_5 -- In what part of the staffing process did you feel you experienced biases or barriers? Interviews\",\"STA_14C_6 -- In what part of the staffing process did you feel you experienced biases or barriers? Reference checks\",\"STA_14C_7 -- In what part of the staffing process did you feel you experienced biases or barriers? Appointments\",\"STA_14C_8 -- In what part of the staffing process did you feel you experienced biases or barriers? Second language evaluation\",\"STA_14C_9 -- In what part of the staffing process did you feel you experienced biases or barriers? Security clearance\",\"STA_15A -- To what extent are you aware of these mechanisms, should you have concerns regarding an appointment process? Contacting the Public Service Commission of Canada (PSC) to request an investigation into an appointment process\",\"STA_15B -- To what extent are you aware of these mechanisms, should you have concerns regarding an appointment process? Contacting the deputy head responsible for the process to request an investigation into their appointment process\",\"STA_15C -- To what extent are you aware of these mechanisms, should you have concerns regarding an appointment process? Filing a staffing complaint with the Federal Public Sector Labour Relations and Employment Board (FPSLREB)\",\"STA_16A -- Would you ever consider using one of these mechanisms if you suspected irregularities in an appointment process?\",\"STA_16B_1 -- You indicated that you would not consider using one of these mechanisms if you suspected irregularities in an appointment process. Why not? Fear of reprisal\",\"STA_16B_2 -- You indicated that you would not consider using one of these mechanisms if you suspected irregularities in an appointment process. Why not? Formal processes are too complicated or too long\",\"STA_16B_3 -- You indicated that you would not consider using one of these mechanisms if you suspected irregularities in an appointment process. Why not? Concerned about confidentiality of information provided\",\"STA_16B_4 -- You indicated that you would not consider using one of these mechanisms if you suspected irregularities in an appointment process. Why not? Mechanisms are not independent or not transparent\",\"STA_16B_5 -- You indicated that you would not consider using one of these mechanisms if you suspected irregularities in an appointment process. Why not? Do not believe it would make a difference\",\"STA_16B_6 -- You indicated that you would not consider using one of these mechanisms if you suspected irregularities in an appointment process. Why not? Other reasons\",\"STA_17 -- To what extent do you agree with the following statement? Diversity and inclusion initiatives related to staffing within my organization are adequate to support building a diverse and representative workforce.\",\"POL_01A -- To what extent do you agree with the following statement? I am aware of my legal rights and responsibilities for engaging in political activities.\",\"POL_01B -- To what extent do you agree with the following statement? If I wanted to seek nomination or become a candidate in a federal, provincial, territorial or municipal election, I am aware of my responsibilities as a public servant.\",\"POL_01C -- To what extent do you agree with the following statement? I know enough or I know where to find information about engagement in political activities.\",\"POL_01D -- To what extent do you agree with the following statement? I understand my responsibilities to be politically impartial in carrying out my duties as a public servant.\",\"POL_01E -- To what extent do you agree with the following statement? My organization keeps me informed of my responsibilities to be politically impartial in carrying out my duties.\",\"POL_01F -- To what extent do you agree with the following statement? In my work unit, employees carry out their duties as public servants in a politically impartial manner.\",\"POL_01G -- To what extent do you agree with the following statement? I am aware that expressing my political views on social media may impact my ability to remain politically impartial or to be perceived as impartial when carrying out my public service duties.\",\"POL_02 -- Between April 1, 2024 and March 31, 2025, other than voting or seeking political candidacy, did you engage in any political activities?\",\"GEN_05 -- Were you a manager or supervisor at any time between April 1, 2024 and March 31, 2025?\",\"GEN_06 -- What is your current employee status?\",\"GEN_08 -- In total, how many years have you been at your current group and level?\",\"COM_10A -- Did your organization undertake innovative staffing practices or initiatives?\",\"LAB_01 -- Regardless of where you currently work physically, in which region, province or territory do you officially report for work?\",\"ED_01 -- What is the highest certificate, diploma or degree that you have completed?\",\"YRS_01 -- In total, how many years have you been working in your current department or agency?\",\"YRS_02 -- In total, how many years have you been working in the federal public service?\",\"AGG_35 -- What is your age group?\",\"GDR_10 -- What is your gender?\",\"GDR_11A_1 -- What is your sexual orientation? Lesbian\",\"GDR_11A_2 -- What is your sexual orientation? Gay\",\"GDR_11A_3 -- What is your sexual orientation? Bisexual\",\"GDR_11A_4 -- What is your sexual orientation? Asexual\",\"GDR_11A_5 -- What is your sexual orientation? Pansexual\",\"GDR_11A_6 -- What is your sexual orientation? Heterosexual\",\"GDR_11A_7 -- What is your sexual orientation? Another sexual orientation\",\"GDR_11A_8 -- What is your sexual orientation? Prefer not to specify\",\"GDR_11B_1 -- Do you identify with any of the following groups? Cisgender (a person who identifies with the sex they were assigned at birth)\",\"GDR_11B_2 -- Do you identify with any of the following groups? Two-Spirit (an Indigenous person in North America who embodies both female and male spirits or whose gender identity, sexual orientation or spiritual identity is not limited by the male/female dichotomy)\",\"GDR_11B_3 -- Do you identify with any of the following groups? Transgender (a person whose gender does not align with the sex they were assigned at birth)\",\"GDR_11B_4 -- Do you identify with any of the following groups? Queer (a person whose sexual orientation or gender differs from the normative binary vision of gender and sexuality)\",\"GDR_11B_5 -- Do you identify with any of the following groups? Questioning (a person who is uncertain of their gender or sexual orientation)\",\"GDR_11B_6 -- Do you identify with any of the following groups? Intersex (a person whose anatomical and physiological characteristics do not meet the medical criteria of the female or male sex)\",\"GDR_11B_7 -- Do you identify with any of the following groups? Gender non-binary (a person whose gender does not align with the binary gender model of man or woman)\",\"GDR_11B_8 -- Do you identify with any of the following groups? Another gender identity\",\"GDR_11B_9 -- Do you identify with any of the following groups? Prefer not to say\",\"FOL_05 -- What is your first official language?\",\"PG_06 -- What is your current marital status? Are you...\",\"PG_07 -- Do you have dependants residing in your household?\",\"ALL_D30A -- Grouped occupational groups\",\"EE -- EE group\",\"DPTSIZE -- Department size\",\"IIDFLAG -- Indigenous identity flag\",\"VISMIN_FL -- Visible minority flag\",\"REL_FL -- Religion flag\",\"DDIS_FL -- Disability flag\",\"HMN_02 -- Between April 1, 2024 and March 31, 2025, in your role as manager or supervisor, which type of staffing processes did you use to staff vacant positions with indeterminate or term employees meant to report to you?\",\"HMN_03_1 -- Why did you use non-advertised appointments? Advertised appointment processes are too complicated or take too long\",\"HMN_03_2