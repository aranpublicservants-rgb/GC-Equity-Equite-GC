:[[\"2023\"],[\"Fonction publique fédérale\"],[\"Federal public service\"],[\"Prise en considération des droits de priorité\",\"Caractéristiques démographiques\",\"Dotation - Employés\",\"Connaissance et compréhension des activités politiques et de l'impartialité politique\",\"Perceptions du mérite, de l'équité et de la transparence\",\"Préjugés et obstacles\",\"Perception des conseils et du soutien en matière de dotation\",\"Perception des politiques et pratiques en matière de dotation de l'organisation\"],[\"Consideration of priority entitlements\",\"Demographic characteristics\",\"Staffing - Employees\",\"Awareness and understanding of political activities and non-partisanship\",\"Perceptions of merit, fairness and transparency\",\"Biases and barriers\",\"Perceptions of staffing advice and support\",\"Perceptions of organizational staffing policies and practices\"],[\"Conseillers en dotation\",\"Employés\",\"Genre\",\"Identité autochtone\",\"Statut d'incapacité\",\"Statut de gestionnaire\",\"Statut de membres des minorités visibles\",\"Statut de membres visés par l'équité en matière d'emploi\",\"Tous les répondants\",\"2ELGBTQIA+\",\"Personnes à charge\",\"Religion\",\"État matrimonial\"],[\"Staffing advisors\",\"Employees\",\"Gender\",\"Indigenous status\",\"Disability status\",\"Manager status\",\"Members of visible minorities status\",\"Employment equity status\",\"All respondents\",\"2SLGBTQIA+\",\"Dependants\",\"Religion\",\"Marital status\"],[\"Conseillers en dotation\",\"Employés\",\"Employés (excluant les gestionnaires et superviseurs)\",\"Gestionnaires\",\"Gestionnaires d'embauche\",\"Gestionnaires et superviseurs qui n'ont pas effectué d'embauche\",\"Tous les répondants\"],[\"Staffing advisors\",\"Employees\",\"Employees (excluding managers and supervisors)\",\"Managers\",\"Hiring managers\",\"Managers or supervisors who did not hire\",\"All respondents\"],[\"Tous les répondants\",\"Autre genre\",\"Femmes\",\"Hommes\",\"Métis\",\"Inuit\",\"Autochtone\",